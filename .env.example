# Gelicenseerde fonts (niet in git). Alleen nodig als public/fonts/ leeg is, bv. op Netlify.
# Map-URL; het script haalt ${FONTS_URL}/<bestand>.woff2 op. Token optioneel (read-only).
FONTS_URL=
FONTS_TOKEN=

# Sanity. Project-id en dataset zijn publiek (komen in de browser).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Server-only, rol Viewer. Voor Visual Editing (drafts in de Presentation tool). Nooit PUBLIC_.
SANITY_API_READ_TOKEN=
# Alleen lokaal, rol Editor, voor scripts/migrate-to-sanity.mjs. Nooit in Netlify; na de migratie intrekken.
SANITY_API_WRITE_TOKEN=
