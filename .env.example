# Cookieloze statistiek (bv. Plausible of Umami). Leeg = uit.
# Laadt alleen na toestemming voor de categorie 'Statistiek' (src/lib/consent.ts).
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=

# Gelicenseerde fonts (niet in git). Alleen nodig als public/fonts/ leeg is, bv. op Netlify.
# Map-URL; het script haalt ${FONTS_URL}/<bestand>.woff2 op. Token optioneel (read-only).
FONTS_URL=
FONTS_TOKEN=
