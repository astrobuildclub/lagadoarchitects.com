---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSettings } from '../lib/content';

const settings = await getSettings();
---

<BaseLayout title={settings.seo.titelPatroon.replace('%s', 'Pagina niet gevonden')} description="Deze pagina bestaat niet (meer)." noindex>
  <div class="layout flow">
    <PageHeader title="Pagina niet gevonden" intro="Deze pagina bestaat niet (meer). Misschien is het project verhuisd." />
    <p><a class="button" href="/projecten">Bekijk alle projecten</a></p>
  </div>
</BaseLayout>
