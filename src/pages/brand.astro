          </thead>
          <tbody>
            {
              LETTERS.map((l) => (
                <tr>
                  <th scope="row">{l.teken}</th>
                  <td>{[...l.stappen.slice(1), l.stappen[0]].map((s) => `${l.standen[s.stand].id} · ${s.ease} · ${String(s.morph).replace('.', ',')}`).join(' → ')}</td>
                  <td>{l.duur} s</td>
                  <td>{l.begin.toString().replace('.', ',').replace('-', '−')} s</td>
                </tr>
