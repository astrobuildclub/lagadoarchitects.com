---
// Brandpagina: logoverkenningen en een weergave van het design system (tokens uit src/styles/tokens.scss).
// Los van Sanity en van de site-layout; niet geïndexeerd. Waarden in px meet de pagina zelf in de browser,
// zodat ze altijd kloppen met de tokens en de huidige schermbreedte.
import Logo from '../components/Logo.astro';
import Wordmark from '../components/brand/Wordmark.astro';
import WordmarkDefs from '../components/brand/WordmarkDefs.astro';
import BrandLayout from '../layouts/BrandLayout.astro';
import { ALFABET, pad, traceer } from '../lib/brand/raster';
import { LETTERKLEUR_DONKER, LETTERKLEUR_LICHT, LETTERS, PALET, SCHETSEN, TEGELS, contrast } from '../lib/brand/wordmark';

export const prerender = true;

const rijen = Math.max(...LETTERS.map((l) => l.standen.length));
const letterStijl = (i: number) => `--g-licht: var(--wm-${LETTERKLEUR_LICHT[i]}); --g-donker: var(--wm-${LETTERKLEUR_DONKER[i]})`;

const siteKleuren = [
  { token: '--color-bg', rol: 'Achtergrond' },
  { token: '--color-surface', rol: 'Vlak' },
  { token: '--color-fg', rol: 'Tekst' },
  { token: '--color-muted', rol: 'Tekst, gedempt' },
  { token: '--color-line', rol: 'Lijn' },
  { token: '--color-accent', rol: 'Accent' },
  { token: '--color-on-accent', rol: 'Op accent' },
  { token: '--color-ink', rol: 'Inkt (header, footer)' },
  { token: '--color-on-ink', rol: 'Op inkt' },
];

const palet = Object.entries(PALET).map(([sleutel, k]) => {
  const c = contrast(k.hex);
  return { sleutel, ...k, ...c, tekst: c.zwart >= c.wit ? 'zwart' : 'wit' };
});
const aa = (r: number) => (r >= 4.5 ? 'AA' : r >= 3 ? 'AA groot' : '—');

const typeStappen = [8, 7, 6, 5, 4, 3, 2, 1, 0, -1, -2, -3];
const ruimte = ['4xs', '3xs', '2xs', 'xs', 's', 'm', 'l', 'xl', '2xl', '3xl', '4xl', '5xl'];
const ruimteParen = ['s-m', 'm-l', 'l-xl', 'xl-2xl', 's-l', 'm-xl', 'l-2xl', 'xl-3xl', 's-3xl'];
const layoutTokens = [
  { token: '--gutter', rol: 'Zijruimte van header, raster en footer' },
  { token: '--content-width', rol: 'Tekstkolom' },
  { token: '--popout-width', rol: 'Uitbreking popout (per kant)' },
  { token: '--feature-width', rol: 'Uitbreking feature (per kant)' },
  { token: '--tile-gap', rol: 'Ruimte tussen projecttegels' },
];
const formaten = [448, 280, 168, 112, 84];

// Legenda van het raster: voorbeeldvormen in dezelfde notatie als de letters (viewBox 0 0 10 10).
const legenda = [
  { vorm: ['0,0 5,0 5,5 0,5'], naam: 'Recht', code: '0,0', uitleg: 'Hoekpunten op de rasterpunten, 0 tot en met 5. De basis volgt het blokkenalfabet uit Figma.' },
  { vorm: ['0,0s 5,0 5,5s 0,5'], naam: 'Schuin', code: '0,0s', uitleg: 'De hoek wordt één blok afgesneden. Met .5 een half blok.' },
  { vorm: ['0,0r 5,0r 5,5 0,5'], naam: 'Afgerond', code: '0,0r', uitleg: 'Afgeronde hoek met een straal van één blok. Nooit helemaal rond.' },
  { vorm: ['0,0 5,0 5,5 0,5', '2,1r.5 3,1r.5 3,4 2,4'], naam: 'Gat', code: '2,1r.5', uitleg: 'Tweede contour is een gat. Met r.5 op de bovenhoeken wordt het halfrond.' },
  { vorm: ['0,0 5,0 5,5 0,5', '2,2 3,1 3,4 2,4'], naam: 'Beweging', code: '2,2 3,1', uitleg: 'Een hoekpunt schuift naar een ander rasterpunt: het gat wordt hoger, lager of scheef.' },
];
const alfabet = Object.entries(ALFABET).map(([teken, bitmap]) => ({ teken, d: traceer(bitmap) }));
// Rasterpunten (6 × 6) als stippen, zoals op het stippenpapier van de schetsen.
// Notatie onder elke stand: hoekpunten in kolommen van gelijke breedte (per letter), gaten op een nieuwe regel.
const notatie = (vorm: string[], breedte: number) => {
  const perRegel = breedte <= 4 ? 4 : 3;
  return vorm
    .flatMap((contour) => {
      const p = contour.trim().split(/\s+/).map((t) => t.padEnd(breedte));
      return Array.from({ length: Math.ceil(p.length / perRegel) }, (_, i) => p.slice(i * perRegel, (i + 1) * perRegel).join(' ').trimEnd());
    })
    .join('\n');
};
const breedtes = LETTERS.map((l) => Math.max(...l.standen.flatMap((s) => (s.vorm ?? []).join(' ').split(/\s+/).map((t) => t.length))));
const punten = Array.from({ length: 36 }, (_, i) => [(i % 6) * 2, Math.floor(i / 6) * 2]);
---

<BrandLayout title="LAGADO brand" description="Woordmerk, kleur, typografie, ruimte en vorm van LAGADO architects. Werkdocument.">
  <WordmarkDefs />

  <header class="balk wrapper--full">
    <a class="balk__home" href="#top" aria-label="LAGADO brand, naar boven">
      <Wordmark variant="static" mono label="LAGADO" style="inline-size: 112px" />
      <span class="label">Brand</span>
    </a>
    <div class="balk__knoppen">
      <a class="toggle" href="/brand/editor">Editor</a>
      <button type="button" class="toggle" data-brand="thema" aria-pressed="false">Donker</button>
      <button type="button" class="toggle" data-brand="kleur" aria-pressed="false">Kleur</button>
      <button type="button" class="toggle" data-brand="pauze">Animatie pauzeren</button>
    </div>
  </header>

  <main id="inhoud" tabindex="-1">
    <div class="wrapper intro" id="top">
      <p class="label muted">Werkdocument · niet openbaar</p>
      <h1>LAGADO brand</h1>
      <p class="lead">
        Woordmerk, kleur, typografie, ruimte en vorm op één plek. De tokens komen rechtstreeks uit de site; de maten in pixels meet deze pagina
        zelf, bij de huidige schermbreedte. Het kinetische woordmerk is een verkenning en nog niet goedgekeurd.
      </p>
      <nav aria-label="Op deze pagina" class="inhoud">
        <a href="#woordmerk">Woordmerk</a>
        <a href="#kleur">Kleur</a>
        <a href="#typografie">Typografie</a>
        <a href="#ruimte">Ruimte</a>
        <a href="#vorm">Vorm</a>
        <a href="#beweging">Beweging</a>
      </nav>
    </div>

    <!-- ───────────── Woordmerk ───────────── -->
    <section id="woordmerk" class="wrapper sectie" aria-labelledby="h-woordmerk">
      <h2 id="h-woordmerk">Woordmerk</h2>
      <p class="noot">
        Zes letters op een raster van 5 × 5 blokken, gebaseerd op potloodschetsen op stippenpapier en op de ingrepen uit het werk van Lagado: recht,
        schuin en licht afgerond. Elke letter is één vorm met de hoekpunten op het raster; de basis volgt het blokkenalfabet uit Figma en elke andere stand is een ingreep op die vorm. De buitenvormen blijven rustig; de beweging zit in de gaten, die hoger, lager en scheef schuiven, en in de L, waar
        de treden door de hoek lopen terwijl rechtsboven altijd open blijft.
      </p>

      <div class="blok">
        <h3 class="label">00 — Raster en ingrepen</h3>
        <ul class="legenda" role="list">
          {
            legenda.map((l) => (
              <li>
                <svg class="legenda__vorm" viewBox="0 0 10 10" aria-hidden="true">
                  <path d={pad(l.vorm)} fill-rule="evenodd" />
                  <g class="punten">{punten.map(([x, y]) => <circle cx={x} cy={y} r="0.18" />)}</g>
                </svg>
                <span>
                  <strong>{l.naam}</strong>
                  <code>{l.code}</code>
                  <span class="meta">{l.uitleg}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="noot muted">
          Een stand is een lijst contouren in <code>src/lib/brand/wordmark.ts</code> (eerst de buitenvorm, dan de gaten); <code>raster.ts</code> maakt er paden van. Alle standen van een
          letter hebben zo dezelfde opbouw en kunnen naar elkaar morphen.
        </p>
      </div>

      <div class="blok">
        <h3 class="label">01 — Hoofdversie, tegels</h3>
        <Wordmark variant="tiles" />
      </div>

      <div class="blok">
        <h3 class="label">02 — Losse letters</h3>
        <Wordmark variant="animated" />
      </div>

      <div class="blok">
        <h3 class="label">03 — Alle standen</h3>
        <div class="matrix-scroll" role="region" aria-label="Alle standen per letter" tabindex="0">
          <div class="matrix">
            <span></span>
            {LETTERS.map((l) => <span class="label">{l.teken}</span>)}
            {
              Array.from({ length: rijen }, (_, r) => (
                <>
                  <span class="label rij">{r + 1}</span>
                  {LETTERS.map((l, i) => {
                    const s = l.standen[r];
                    return s ? (
                      <figure class="cel">
                        <svg class="wm" viewBox="0 0 10 10" role="img" aria-label={s.label}>
                          <use href={`#wm-${s.id}`} class="wm-l" style={letterStijl(i)} />
                          <g class="punten">{punten.map(([x, y]) => <circle cx={x} cy={y} r="0.12" />)}</g>
                        </svg>
                        <figcaption>
                          {s.id}
                          {s.vorm && <pre class="notatie">{notatie(s.vorm, breedtes[i])}</pre>}
                        </figcaption>
                      </figure>
                    ) : (
                      <span />
                    );
                  })}
                </>
              ))
            }
            <span class="label rij">Schets<br /><span class="meta">oud</span></span>
            {
              SCHETSEN.map((s, i) =>
                s ? (
                  <figure class="cel">
                    <svg class="wm" viewBox="0 0 10 10" role="img" aria-label={s.label}>
                      <use href={`#wm-${s.id}`} class="wm-l" style={letterStijl(i)} />
                    </svg>
                    <figcaption>{s.id}</figcaption>
                  </figure>
                ) : (
                  <span />
                ),
              )
            }
          </div>
        </div>
        <p class="noot muted">De rij Schets (gevel, deur, poort) komt uit de eerste verkenning, van vóór het blokraster. Die vormen staan nog niet op het raster en zitten niet in de animatie.</p>
      </div>

      <div class="blok">
        <h3 class="label">04 — Hover, letters rollen na elkaar door</h3>
        <Wordmark variant="hover" href="#woordmerk" />
        <p class="noot muted">Stilstaand logo. Bij hover of focus rolt elke letter met 70 ms vertraging naar zijn tweede stand, en terug bij loslaten.</p>
      </div>

      <div class="blok">
        <h3 class="label">05 — Formaten</h3>
        <div class="formaten">
          {
            formaten.map((px) => (
              <div class="formaat">
                <span class="meta">
                  {px} px{px <= 112 && ' · altijd één kleur'}
                  {px === 84 && ' · kleinste maat'}
                </span>
                <Wordmark variant="animated" mono={px <= 112} maat={px <= 112 ? 'klein' : 'groot'} style={`inline-size: ${px}px`} />
              </div>
            ))
          }
        </div>
      </div>

      <div class="blok">
        <h3 class="label">06 — In de header</h3>
        <div class="demo-header">
          <Wordmark variant="animated" mono maat="klein" style="inline-size: 112px" />
          <ul class="demo-nav" aria-label="Voorbeeldnavigatie">
            <li>Projecten</li>
            <li>Studio</li>
            <li>Contact</li>
          </ul>
        </div>
      </div>

      <div class="blok">
        <h3 class="label">07 — Preloader</h3>
        <div class="preloader">
          <Wordmark variant="animated" mono invert label="LAGADO, laden" style="inline-size: min(26rem, 80%)" />
          <div class="preloader__spoor"><div class="preloader__balk"></div></div>
        </div>
      </div>

      <div class="blok">
        <h3 class="label">08 — Huidig woordmerk op de site</h3>
        <div class="huidig">
          <Logo class="huidig__logo" />
          <span class="visually-hidden">LAGADO</span>
        </div>
        <p class="noot muted">Ter vergelijking: <code>src/components/Logo.astro</code>, de voorlopige versie uit Figma.</p>
      </div>

      <div class="blok">
        <h3 class="label">09 — Alfabet uit Figma, 5 × 5</h3>
        <ul class="alfabet" role="list">
          {
            alfabet.map((a) => (
              <li>
                <svg class="wm" viewBox="0 0 10 10" role="img" aria-label={a.teken}>
                  <path class="wm-gp" d={a.d} />
                  <g class="punten">{punten.map(([x, y]) => <circle cx={x} cy={y} r="0.15" />)}</g>
                </svg>
              </li>
            ))
          }
        </ul>
        <p class="noot muted">De basisstanden van LAGADO komen hieruit. Met dezelfde ingrepen kan elke letter bewegen, bijvoorbeeld voor koppen of de 404-pagina.</p>
      </div>

      <div class="blok kolommen">
        <div>
          <h3>Vastgestelde regels</h3>
          <ul class="lijst">
            <li>Elke letter is één vorm op een raster van 5 × 5: hoekpunten op de rasterpunten. Standen ontstaan door ingrepen op die vorm.</li>
            <li>Buitenvormen blijven rustig. De beweging zit vooral in de gaten: hoger, lager, scheef.</li>
            <li>Niets wordt helemaal rond. Alleen afgeronde hoeken.</li>
            <li>De L blijft altijd een L: rechtsboven is altijd leeg.</li>
            <li>Als de bovenkant van de A afgerond is, is het gat ook afgerond.</li>
            <li>De twee A's hebben verschillende standen en een ander ritme.</li>
            <li>Geen isometrische of perspectiefversie.</li>
            <li>Kleinste maten en de header zijn altijd één kleur.</li>
          </ul>
        </div>
        <div>
          <h3>Open punten</h3>
          <ul class="lijst">
            <li>Alle standen zijn opnieuw op 5 × 5 gezet en nog niet beoordeeld. De L-trap en de schuine L zijn nieuw.</li>
            <li>De D-vleugel past niet op het raster; die is vervangen door een D met hoog gat.</li>
            <li>Gaten zijn één blok breed; een rond gat heeft een straal van een half blok. Is dat genoeg, of moet het raster fijner (10 × 10)?</li>
            <li>De schetsvormen (gevel-G, deur-D, poort-O) nog naar het raster vertalen, of laten vallen.</li>
            <li>Zwarte tegels in donker met kleur: nu met een lijn in <code>--color-line</code>. Beoordelen.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ───────────── Kleur ───────────── -->
    <section id="kleur" class="wrapper sectie" aria-labelledby="h-kleur">
      <h2 id="h-kleur">Kleur</h2>

      <div class="blok">
        <h3 class="label">Site-tokens</h3>
        <p class="noot muted">OKLCH, licht en donker via <code>data-theme</code> of <code>prefers-color-scheme</code>. Wissel het thema bovenaan om beide te zien.</p>
        <ul class="swatches" role="list">
          {
            siteKleuren.map((k) => (
              <li class="swatch">
                <span class="swatch__vlak" style={`background: var(${k.token})`} />
                <span class="swatch__naam">{k.rol}</span>
                <code>{k.token}</code>
                <code class="meta" data-var={k.token} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="blok">
        <h3 class="label">Palet woordmerk (verkenning)</h3>
        <p class="noot muted">Geel en roze halen op wit geen tekstcontrast: daar alleen decoratief gebruiken.</p>
        <ul class="palet" role="list">
          {
            palet.map((k) => (
              <li class="palet__kleur" style={`background: var(--wm-${k.sleutel}); color: var(--wm-${k.tekst})`}>
                <strong>{k.naam}</strong>
                <code>{k.oklch}</code>
                <code>{k.hex}</code>
                <span class="meta">
                  op wit {k.wit.toFixed(2)} ({aa(k.wit)}) · op zwart {k.zwart.toFixed(2)} ({aa(k.zwart)})
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="blok">
        <h3 class="label">Tegelcombinaties</h3>
        <ul class="combis" role="list">
          {
            TEGELS.map(([tegel, letter], i) => (
              <li>
                <svg class="combi" viewBox="0 0 14 14" role="img" aria-label={`${LETTERS[i].teken}: ${letter} op ${tegel}`}>
                  <rect width="14" height="14" style={`fill: var(--wm-${tegel})`} />
                  <use href={`#wm-${LETTERS[i].standen[0].id}`} transform="translate(2 2)" style={`--g: var(--wm-${letter})`} />
                </svg>
                <span class="meta">
                  {letter} op {tegel}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ───────────── Typografie ───────────── -->
    <section id="typografie" class="wrapper sectie" aria-labelledby="h-typografie">
      <h2 id="h-typografie">Typografie</h2>

      <div class="blok kolommen">
        <div class="font">
          <p class="font__voorbeeld">Aa</p>
          <h3>ABC Areal</h3>
          <p class="meta"><code>--font-sans</code> · variabel: wght 400–700, slnt −12–0, DRKM 0–1</p>
        </div>
        <div class="font font--mono">
          <p class="font__voorbeeld">Aa</p>
          <h3>ABC Areal Mono</h3>
          <p class="meta"><code>--font-mono</code> · zelfde assen</p>
        </div>
      </div>

      <div class="blok">
        <h3 class="label">Assen</h3>
        <div class="assen">
          <p style="font-weight: 400">Gewicht 400</p>
          <p style="font-weight: 500">Gewicht 500</p>
          <p style="font-weight: 600">Gewicht 600</p>
          <p style="font-weight: 700">Gewicht 700</p>
          <p style="font-style: oblique 12deg">Schuin 12°</p>
          <p style="font-variation-settings: 'DRKM' 0">DRKM 0</p>
          <p style="font-variation-settings: 'DRKM' 1">DRKM 1, voor licht op donker</p>
        </div>
      </div>

      <div class="blok">
        <h3 class="label">Schaal (Utopia, 16→18 px, 1.2→1.333)</h3>
        <ol class="schaal" role="list">
          {
            typeStappen.map((s) => (
              <li class="schaal__rij">
                <span class="meta">
                  <code>--step-{s}</code> · <span data-meet="font" data-doel={`#stap-${s}`} />
                </span>
                <span class="schaal__voorbeeld" id={`stap-${s}`} style={`font-size: var(--step-${s})`}>
                  Ruimte voor wonen en werken
                </span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="blok proef">
        <h3 class="label">Koppen en lopende tekst</h3>
        <p class="kop1">Huis aan de dijk</p>
        <p class="kop2">Een verbouwing in drie lagen</p>
        <p class="kop3">Licht, lucht en ruimte</p>
        <p class="prose">
          Lopende tekst staat op <code>--step-0</code> met regelafstand <code>--leading-normal</code> en een maximale breedte van <code>--measure</code>.
          Koppen gebruiken <code>--leading-tight</code>, gewicht 600 en een iets krappere letterspatiëring. <em>Cursief is de slant-as</em>, geen
          gesynthetiseerde schuine letter.
        </p>
      </div>
    </section>

    <!-- ───────────── Ruimte ───────────── -->
    <section id="ruimte" class="wrapper sectie" aria-labelledby="h-ruimte">
      <h2 id="h-ruimte">Ruimte</h2>
      <p class="noot muted">Utopia-ruimteschaal, vloeiend tussen 360 en 2560 px schermbreedte. Paren (bijv. <code>s-l</code>) groeien sterker mee.</p>

      <div class="blok">
        <h3 class="label">Stappen</h3>
        <ol class="ruimte" role="list">
          {
            ruimte.map((r) => (
              <li class="ruimte__rij">
                <code>--space-{r}</code>
                <span class="ruimte__balk" style={`inline-size: var(--space-${r})`} />
                <span class="meta" data-meet="breedte" />
              </li>
            ))
          }
        </ol>
      </div>

      <div class="blok">
        <h3 class="label">Paren</h3>
        <ol class="ruimte" role="list">
          {
            ruimteParen.map((r) => (
              <li class="ruimte__rij">
                <code>--space-{r}</code>
                <span class="ruimte__balk ruimte__balk--paar" style={`inline-size: var(--space-${r})`} />
                <span class="meta" data-meet="breedte" />
              </li>
            ))
          }
        </ol>
      </div>

      <div class="blok">
        <h3 class="label">Layout</h3>
        <ol class="ruimte" role="list">
          {
            layoutTokens.map((t) => (
              <li class="ruimte__rij">
                <span>
                  <code>{t.token}</code>
                  <span class="meta"> · {t.rol}</span>
                </span>
                <span class="ruimte__balk ruimte__balk--layout" style={`inline-size: min(var(${t.token}), 100%)`} />
                <span class="meta" data-meet="breedte" />
              </li>
            ))
          }
        </ol>
        <p class="noot muted">
          Breakout-grid (<code>layout.css</code>): full ┃ feature ┃ popout ┃ content ┃ popout ┃ feature ┃ full. Paginabegin: <code>--page-top</code> = 30svh.
        </p>
      </div>
    </section>

    <!-- ───────────── Vorm ───────────── -->
    <section id="vorm" class="wrapper sectie" aria-labelledby="h-vorm">
      <h2 id="h-vorm">Vorm</h2>
      <p class="noot muted">
        Dezelfde drie ingrepen als in het woordmerk: recht, schuin en afgerond. Op een element met <code>data-vorm</code> of <code>data-kaartvorm</code>
        (<code>vorm.css</code>).
      </p>

      <div class="blok">
        <h3 class="label">data-vorm</h3>
        <ul class="vormen" role="list">
          {
            ['recht', 'rond', 'schuin'].map((v) => (
              <li data-vorm={v}>
                <span class="vorm" />
                <code>{v}</code>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="blok">
        <h3 class="label">data-kaartvorm (homeraster)</h3>
        <ul class="vormen" role="list">
          {
            ['ovaal', 'afgerond', 'zacht', 'recht', 'schuin'].map((v) => (
