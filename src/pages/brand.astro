<script>
  const root = document.documentElement;
  const donkerSysteem = matchMedia('(prefers-color-scheme: dark)');
  const isDonker = () => (root.dataset.theme ? root.dataset.theme === 'dark' : donkerSysteem.matches);

  const bewaar = (k: string, v: string | null) => {
    try {
      if (v === null) localStorage.removeItem(k);
      else localStorage.setItem(k, v);
    } catch {}
  };

  const knop = (naam: string) => document.querySelector<HTMLButtonElement>(`[data-brand="${naam}"]`)!;

  function sync() {
    knop('thema').setAttribute('aria-pressed', String(isDonker()));
    knop('kleur').setAttribute('aria-pressed', String('kleur' in root.dataset));
    // Pauzeknop: de tekst zegt wat de knop doet (geen aria-pressed, dan zou de naam vast moeten blijven).
    const gepauzeerd = 'wmPauze' in root.dataset;
    knop('pauze').textContent = gepauzeerd ? 'Animatie afspelen' : 'Animatie pauzeren';
    knop('pauze').toggleAttribute('data-actief', gepauzeerd);
    meet();
  }

  knop('thema').addEventListener('click', () => {
    const volgende = isDonker() ? 'light' : 'dark';
    // Terug naar de systeemstand als die gelijk is aan de keuze: dan volgt de site het systeem weer.
    const systeem = donkerSysteem.matches ? 'dark' : 'light';
    if (volgende === systeem) {
      delete root.dataset.theme;
      bewaar('theme', null);
    } else {
      root.dataset.theme = volgende;
      bewaar('theme', volgende);
    }
    sync();
  });

  knop('kleur').addEventListener('click', () => {
    if ('kleur' in root.dataset) delete root.dataset.kleur;
    else root.dataset.kleur = '';
    bewaar('brand-kleur', 'kleur' in root.dataset ? '1' : null);
    sync();
  });

  knop('pauze').addEventListener('click', () => {
    if ('wmPauze' in root.dataset) delete root.dataset.wmPauze;
    else root.dataset.wmPauze = '';
    bewaar('brand-pauze', 'wmPauze' in root.dataset ? '1' : null);
    sync();
  });

  donkerSysteem.addEventListener('change', sync);

  /** Tokenwaarden en gemeten maten invullen (bij laden, resize en themawissel). */
  function meet() {
    const stijl = getComputedStyle(root);
    document.querySelectorAll<HTMLElement>('[data-var]').forEach((el) => {
      el.textContent = stijl.getPropertyValue(el.dataset.var!).trim();
    });
    document.querySelectorAll<HTMLElement>('[data-meet="font"]').forEach((el) => {
      const doel = document.querySelector(el.dataset.doel!);
      if (doel) el.textContent = `${parseFloat(getComputedStyle(doel).fontSize).toFixed(1)} px`;
    });
    document.querySelectorAll<HTMLElement>('[data-meet="breedte"]').forEach((el) => {
      const balk = el.previousElementSibling as HTMLElement | null;
      if (balk) el.textContent = `${balk.getBoundingClientRect().width.toFixed(1)} px`;
    });
  }

  let frame = 0;
  addEventListener('resize', () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(meet);
  });
  document.fonts?.ready.then(meet);
  sync();
</script>

