---
// Contact: geen formulier en geen kaart-iframe (AVG). Gegevens uit lagado-content/contact.md.
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import PageHeader from '../components/PageHeader.astro';
import { getContact, getSettings } from '../lib/content';
import { downloadUrl, pageImage } from '../lib/images';
import { md } from '../lib/markdown';
import { pageDescription, pageTitle } from '../lib/seo';

const settings = await getSettings();
const c = await getContact();
const sfeerbeeld = c.sfeerbeeld?.src ? pageImage(c.sfeerbeeld.src) : undefined;
const kaartBeeld = c.kaart?.statischBeeld?.src ? pageImage(c.kaart.statischBeeld.src) : undefined;
const tel = c.telefoon?.replace('(0)', '').replace(/[^\d+]/g, '');
const social = c.social.filter((s) => s.href);
const downloads = c.downloads.map((d) => ({ ...d, url: downloadUrl(d.bestand) })).filter((d) => d.url);
---

<BaseLayout title={pageTitle(settings, c)} description={pageDescription(settings, { ...c, fallbackDescription: c.intro })}>
  <div class="layout flow">
    <PageHeader title={c.title} intro={c.intro} />

    {
      sfeerbeeld && (
        <figure class="feature">
          <Img src={sfeerbeeld} alt={c.sfeerbeeld!.alt} priority />
        </figure>
      )
    }

    {c.tekst && <div class="prose" set:html={md(c.tekst)} />}

    <div class="contact popout">
      <section>
        <h2>Contact</h2>
        {c.contactpersoon && <p>{c.contactpersoon.naam}{c.contactpersoon.rol && <span class="muted"><br />{c.contactpersoon.rol}</span>}</p>}
        <p>
          {c.email && <a href={`mailto:${c.email}`}>{c.email}</a>}
          {c.email && c.telefoon && <br />}
          {c.telefoon && <a href={`tel:${tel}`}>{c.telefoon}</a>}
        </p>
      </section>

      <section>
        <h2>Bezoekadres</h2>
        <address>
          {c.adres.naam && <>{c.adres.naam}<br /></>}
          {c.adres.straat}<br />
          {c.adres.postcode} {c.adres.plaats}
        </address>
        {c.adres.bezoek && <p class="muted">{c.adres.bezoek}</p>}
        {c.kaart?.link && <p><a href={c.kaart.link} rel="noopener">Bekijk op de kaart</a></p>}
      </section>

      {
        social.length > 0 && (
          <section>
            <h2>Volg ons</h2>
            <ul role="list">
              {social.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
            </ul>
          </section>
        )
      }

      <section>
        <h2>Gegevens</h2>
        <ul role="list">
          {c.bedrijf.kvk && <li>KvK {c.bedrijf.kvk}</li>}
          {c.bedrijf.btw && <li>btw {c.bedrijf.btw}</li>}
          {c.bedrijf.architectenregister && <li>Architectenregister {c.bedrijf.architectenregister}</li>}
          {c.bedrijf.lidmaatschappen.map((l) => <li>{l.href ? <a href={l.href} rel="noopener">{l.label}</a> : l.label}</li>)}
        </ul>
      </section>

      {
        downloads.length > 0 && (
          <section>
            <h2>Downloads</h2>
            <ul role="list">
              {downloads.map((d) => <li><a href={d.url} download>{d.label}</a></li>)}
            </ul>
          </section>
        )
      }
    </div>

    {
      kaartBeeld && (
        <figure class="feature">
          <Img src={kaartBeeld} alt={c.kaart!.statischBeeld!.alt} />
        </figure>
      )
    }
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-l);
  }
  .contact h2 {
    font-size: var(--step-0);
    margin-block-end: var(--space-2xs);
  }
  address {
    font-style: normal;
  }
</style>
