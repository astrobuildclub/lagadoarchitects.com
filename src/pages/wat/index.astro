---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectFilter from '../../components/ProjectFilter.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects, getSettings } from '../../lib/content';
import { pageDescription, pageTitle } from '../../lib/seo';

const settings = await getSettings();
const projects = await getProjects();
const page = { title: 'Wat we maken', fallbackDescription: `Architectuur en interieur van ${settings.siteNaam}: ${settings.payoff.toLowerCase()}.` };
---

<BaseLayout title={pageTitle(settings, page)} description={pageDescription(settings, page)}>
  <!-- Volle breedte. Vanaf 40rem staan de filters in een kolom links naast de projecten,
       daaronder zit de overlay achter de knop "Filters" (zie ProjectFilter). -->
  <div class="wrapper wrapper--full wat">
    <PageHeader title="Wat" intro={settings.projecten.intro} />
    <div class="wat__body">
      <ProjectFilter projects={projects} toonPrijs={settings.projecten.toonPrijsfilter} target="projecten" />
      <ProjectList projects={projects} headingLevel={2} id="projecten" />
    </div>
  </div>
</BaseLayout>

<style>
  .wat__body {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-l);
  }
  @media (width >= 40rem) {
    .wat__body {
      grid-template-columns: minmax(13rem, 16rem) 1fr;
      align-items: start;
      gap: var(--space-l) var(--space-xl);
    }
  }
</style>
