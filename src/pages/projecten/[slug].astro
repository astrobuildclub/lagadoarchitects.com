---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';
import Img from '../../components/Img.astro';
import NextProject from '../../components/NextProject.astro';
import ProjectCredits from '../../components/ProjectCredits.astro';
import ProjectFacts from '../../components/ProjectFacts.astro';
import { getNextProject, getProjects, getSettings } from '../../lib/content';
import { projectImage } from '../../lib/images';
import { kaartkleur } from '../../lib/projectkleur';
import { md } from '../../lib/markdown';
import { pageDescription, pageTitle } from '../../lib/seo';
import type { Project } from '../../lib/schema';
import { cleanPath } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
const settings = await getSettings();
const next = await getNextProject(project);
const hero = projectImage(project.slug, project.hero.src);
// De foto in de kop heeft de vorm van het project (styles/vorm.css). De projectkleur (accentkleur,
// anders uit het hero-beeld) zit in de transitie, de vraag, de tekstselectie en de focusring.
const kleur = await kaartkleur(project);
const vorm = project.vorm[0] ?? 'recht';
const kaartvorm = ({ rond: 'ovaal', recht: 'zacht', schuin: 'schuin' } as const)[vorm];
const url = new URL(cleanPath(Astro.url.pathname), settings.url).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title,
    headline: project.tagline,
    description: project.intro.trim(),
    url,
    creator: { '@id': `${settings.url}/#organisatie` },
    locationCreated: { '@type': 'Place', name: [project.locatie.wijk, project.locatie.plaats].filter(Boolean).join(', ') },
    ...(project.jaarOplevering && { dateCreated: String(project.jaarOplevering) }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', settings.url).href },
      { '@type': 'ListItem', position: 2, name: 'Projecten', item: new URL('/projecten', settings.url).href },
      { '@type': 'ListItem', position: 3, name: project.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={pageTitle(settings, project)}
  description={pageDescription(settings, { ...project, fallbackDescription: `${project.tagline} ${project.intro}` })}
  image={hero}
  imageAlt={project.hero.alt}
  type="article"
  accent={kleur.vlak}
  accentTekst={kleur.tekst}
  jsonLd={jsonLd}
>
  <article class="layout flow" data-reveal>
    <header class="project-kop full" data-vorm={vorm} data-kaartvorm={kaartvorm} data-kop-in>
      <div class="project-kop__tekst">
        <div class="project-kop__intro" data-words-in>
          <h1>{project.title}</h1>
          <p class="project-kop__tagline">
            {
              project.tagline.split(' ').map((woord, i) => (
                <>
                  {i > 0 && ' '}
                  <span class="w">
                    <span class="w__i">{woord}</span>
                  </span>
                </>
              ))
            }
          </p>
          <div class="project-kop__verhaal" set:html={md(project.intro)} />
        </div>
        <ProjectFacts project={project} />
      </div>
      <Img src={hero} alt={project.hero.alt} priority sizes="(min-width: 48rem) 30vw, 100vw" class="project-kop__beeld" />
    </header>

    {
      project.vraag && (
        <p class="project-vraag popout" data-ink style={`--vraag-kleur: ${kleur.vlak}`}>
          <span class="project-vraag__label">Vraag</span>
          {project.vraag.split(' ').map((woord, i) => (
            <>
              {i > 0 && ' '}
              <span class="ink">{woord}</span>
            </>
          ))}
        </p>
      )
    }

    <BlockRenderer blocks={project.blocks} scope={{ project: project.slug, kleurpalet: project.kleurpalet }} />

    <ProjectCredits project={project} />
    {next && <NextProject project={next} />}
  </article>
</BaseLayout>

<script>
  import '../../scripts/words-in';
  import '../../scripts/kop-in';
  import '../../scripts/ink-in';
  import '../../scripts/reveal';
</script>

<style>
  /* Projectkop (Figma 463:9724): tekst over twee kolommen, de foto in de vorm van het project in de
     derde. Titel klein, de tagline groot (step-5), intro in step-0 tot 500px, daaronder de factsheet.
     Mobiel de foto boven. Geen kleurvlak: de projectkleur zit in de paginatransitie. */
  .project-kop {
    display: grid;
    gap: var(--space-l);
    padding: var(--page-top) var(--gutter) 0;
  }
  .project-kop :global(.project-kop__beeld) {
    order: -1;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 9 / 10;
    object-fit: cover;
    border-radius: var(--vorm-radius);
    clip-path: var(--vorm-clip);
  }
  .project-kop__tekst {
    display: grid;
    align-content: center;
    gap: var(--space-xl);
  }
  .project-kop__intro {
    display: grid;
    gap: var(--space-xs);
  }
  .project-kop h1 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.125;
  }
  .project-kop__tagline {
    margin: calc(var(--space-s) - var(--space-xs)) 0 0;
    font-size: var(--step-5);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.125;
    text-wrap: balance;
  }
  .project-kop__verhaal {
    max-inline-size: 500px;
    font-size: var(--step-0);
    letter-spacing: -0.02em;
    line-height: 1.5;
  }
  .project-kop__verhaal :global(p) {
    margin: 0;
  }
  .project-kop__verhaal :global(p + p) {
    margin-block-start: 0.75em;
  }
  @media (min-width: 48rem) {
    .project-kop {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-l);
    }
    .project-kop__tekst {
      grid-column: span 2;
    }
    .project-kop :global(.project-kop__beeld) {
      order: 0;
      align-self: start;
      aspect-ratio: 437 / 540;
    }
  }
  .project-vraag {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-fg);
  }
  /* Inkleuren bij scrollen (ink-in.ts): in de projectkleur tot het woord aan de beurt is, dan de
     tekstkleur. Zonder JS of met reduced motion staat alles in de tekstkleur (WCAG-contrast). */
  .project-vraag[data-ink-on] .ink {
    color: var(--vraag-kleur);
    transition: color 0.35s var(--ease);
  }
  .project-vraag[data-ink-on] .ink.is-in {
    color: var(--color-fg);
  }
  .project-vraag__label {
    display: block;
    margin-block-end: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
  }
</style>
