---
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/index.css';
import CookieConsent from '../components/CookieConsent.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SiteMeta from '../components/SiteMeta.astro';
import { getContact, getSettings } from '../lib/content';
import { organizationJsonLd } from '../lib/seo';
import { cleanPath } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  /** oklch()-waarde; overschrijft --accent op deze pagina. */
  accent?: string;
}

const { accent, jsonLd = [], ...meta } = Astro.props;
const settings = await getSettings();
const contact = await getContact();
const isHome = cleanPath(Astro.url.pathname) === '/';
---

<!doctype html>
<html lang={settings.taal} style={accent ? `--accent: ${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <SiteMeta settings={settings} {...meta} jsonLd={[...(isHome ? [organizationJsonLd(settings, contact)] : []), ...jsonLd]} />

    <!-- Thema vóór de eerste paint: alleen data-theme bij handmatige override; anders volgt CSS prefers-color-scheme. -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          let theme;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme === 'light' || theme === 'dark') doc.documentElement.dataset.theme = theme;
          else doc.documentElement.removeAttribute('data-theme');
        };
        apply(document);
        document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
      })();
    </script>

    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#inhoud">Naar de inhoud</a>
    <Header settings={settings} />
    <main id="inhoud" tabindex="-1">
      <slot />
    </main>
    <Footer settings={settings} contact={contact} />
    <CookieConsent />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    z-index: 10;
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-fg);
    color: var(--color-bg);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  main:focus {
    outline: none;
  }
</style>
