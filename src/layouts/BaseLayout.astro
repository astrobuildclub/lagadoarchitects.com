---
import { ClientRouter } from 'astro:transitions';
import '../styles/index.css';
import CookieConsent from '../components/CookieConsent.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Interlude from '../components/Interlude.astro';
import SiteMeta from '../components/SiteMeta.astro';
import { getContact, getSettings } from '../lib/content';
import VisualEditing from '../lib/sanity/VisualEditing';
import type { SanityImage } from '../lib/schema';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: SanityImage;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  /** oklch()-waarde; overschrijft --accent op deze pagina (selectie, focusring: base.css). */
  accent?: string;
  /** Tekst op --accent (zwart of wit op contrast), voor de tekstselectie. */
  accentTekst?: string;
}

const { accent, accentTekst, jsonLd = [], ...meta } = Astro.props;
const accentStijl = [accent && `--accent: ${accent}`, accentTekst && `--accent-tekst: ${accentTekst}`].filter(Boolean).join('; ');
const settings = await getSettings();
const contact = await getContact();
// Bureau en website op elke pagina: projecten en de website verwijzen naar #organisatie.
const structuredData = [organizationJsonLd(settings, contact), websiteJsonLd(settings), ...jsonLd];
// Alleen in de iframe van de Presentation tool, met een geldige preview-cookie (middleware.ts).
const visualEditing = Astro.locals.visualEditing;
const stats = settings.analytics;
---

<!doctype html>
<html lang={settings.taal} style={accentStijl || undefined} data-accent={accent ? '' : undefined} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/ABCArealVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="generator" content={Astro.generator} />
    <SiteMeta settings={settings} {...meta} jsonLd={structuredData} />

    <!-- Vóór de eerste paint: data-theme alleen bij handmatige override (anders volgt CSS prefers-color-scheme), en data-js. -->
    <script is:inline>
      (() => {
        const apply = (doc) => {
          let theme;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme === 'light' || theme === 'dark') doc.documentElement.dataset.theme = theme;
          else doc.documentElement.removeAttribute('data-theme');
          // JS draait: woorden die inschuiven (words-in.ts) starten verborgen, zonder flits.
          doc.documentElement.dataset.js = '';
        };
        apply(document);
        document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
      })();
    </script>

    {
      // Cookieloze statistiek: geen toestemming nodig (zie src/lib/consent.ts). Niet in dev en niet in de
      // preview van de Studio, zodat redacteuren niet meetellen. Google Analytics laadt pas na toestemming.
      !import.meta.env.DEV && !visualEditing && stats?.dienst === 'umami' && stats.umamiId && (
        <script is:inline defer src={stats.umamiScript || 'https://cloud.umami.is/script.js'} data-website-id={stats.umamiId} />
      )
    }
    {
      !import.meta.env.DEV && !visualEditing && stats?.dienst === 'plausible' && stats.plausibleDomein && (
        <script is:inline defer src={stats.plausibleScript || 'https://plausible.io/js/script.js'} data-domain={stats.plausibleDomein} />
      )
    }

    <ClientRouter fallback="swap" />
  </head>
  <body>
    <!-- Paginatransities (Interlude, zie TRANSITIONS.md §7): direct kind van <body>. -->
    <Interlude />
    <a class="skip-link" href="#inhoud">Naar de inhoud</a>
    <Header settings={settings} contact={contact} />
    <main id="inhoud" tabindex="-1">
      <slot />
    </main>
    <Footer settings={settings} />
    <CookieConsent analytics={settings.analytics} />
    <script>
      import '../scripts/transitie-kleur';
    </script>
    {visualEditing && <VisualEditing client:only="react" />}
    {
      visualEditing && (
        <script is:inline>
          // Alleen in de Presentation tool: elke klik wordt een volledige page load i.p.v. een
          // ClientRouter-swap. De router haalt pagina's op via fetch (Sec-Fetch-Dest: empty), dus zonder
          // Visual Editing; dan verliest de Studio de verbinding. Op window in de capture-fase: dit draait
          // vóór Interlude en de router, die allebei links met data-astro-reload met rust laten.
          window.addEventListener(
            'click',
            (event) => {
              const link = event.target instanceof Element && event.target.closest('a[href]');
              if (link) link.setAttribute('data-astro-reload', '');
            },
            true,
          );
        </script>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    z-index: 10;
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-fg);
    color: var(--color-bg);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  main:focus {
    outline: none;
  }
</style>
