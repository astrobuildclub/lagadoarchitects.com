---
// Eén regel in een pers- of awardlijst (blocks/List.astro): jaar, tekst (evt. link), resultaat, project.
// Layout (twee kolommen vanaf 48rem) staat in List.astro: de li is een subgrid van de lijst.
import { label } from '../lib/labels';

interface Props {
  jaar?: number;
  titel?: string;
  url?: string;
  resultaat?: string;
  project?: { slug: string; title: string };
  /** Achter "Toon alles": verborgen tot de knop is ingedrukt. */
  meer?: boolean;
}
const { jaar, titel, url, resultaat, project, meer = false } = Astro.props;
---

<li class="list-item" hidden={meer} data-meer={meer || undefined}>
  <span class="list-item__jaar">{jaar ?? ''}</span>
  <div class="list-item__inhoud">
    <p class="list-item__tekst">
      {url ? <a href={url} rel="noopener">{titel}</a> : titel}
      {resultaat && <span class="muted"> ({label(resultaat)})</span>}
    </p>
    {project && <a class="list-item__project" href={`/projecten/${project.slug}`}>{project.title}</a>}
  </div>
</li>
