---
// Laadt cookie-consent + iframemanager (zie src/lib/consent.ts). Draait opnieuw na elke
// page swap van de ClientRouter, zodat nieuwe video-embeds de juiste status krijgen.
// De keuze voor statistiek komt uit de site-instellingen (Statistiek).
// CSS in de frontmatter: Astro zet hem als <link>/<style> in de <head> van elke pagina.
// Vanuit het <script> geïmporteerd voegt Vite hem in dev pas via JavaScript toe; faalt dat script
// (bv. 504 Outdated Optimize Dep), dan staat de video-melding onopgemaakt in de pagina.
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import '@orestbida/iframemanager/dist/iframemanager.css';
import type { ConsentConfig } from '../lib/consent';
import type { Settings } from '../lib/schema';

interface Props {
  analytics: Settings['analytics'];
}
const { analytics } = Astro.props;
const config: ConsentConfig = {
  googleId: analytics.dienst === 'google' ? analytics.googleId : undefined,
  cookieloos: analytics.dienst === 'umami' ? 'Umami' : analytics.dienst === 'plausible' ? 'Plausible' : undefined,
};
---

<script type="application/json" id="consent-config" set:html={JSON.stringify(config)} />

<script>
  import { initConsent, type ConsentConfig } from '../lib/consent';
  import { initVideoPlayer } from '../lib/video-player';

  const config = (): ConsentConfig => JSON.parse(document.getElementById('consent-config')?.textContent || '{}');
  document.addEventListener('astro:page-load', () => {
    initVideoPlayer();
    initConsent(config());
  });
</script>

<style is:global>
  /*
   * Video-placeholder (iframemanager) op de site-tokens. --accent is op een projectpagina de kleur van
   * het project (BaseLayout), elders de sitekleur; --accent-tekst is zwart of wit, gekozen op contrast.
   * Overlay: grotendeels de projectkleur, rechtsboven schemert de thumbnail door. De tekst staat in het
   * midden, waar de kleur nog ~80% dekt: zo blijft --accent-tekst leesbaar op elk beeld.
   */
  div[data-service] {
    --im-font-family: var(--font-sans);
    --im-bg: var(--accent);
    --im-color: var(--accent-tekst, var(--color-on-accent));
    --im-overlay-bg: linear-gradient(
      14deg,
      var(--accent) 0%,
      color-mix(in oklch, var(--accent) 85%, transparent) 50%,
      color-mix(in oklch, var(--accent) 45%, transparent) 100%
    );
    --im-link-color: currentColor;
    --im-link-hover-color: currentColor;
    /* "Video laden": omgekeerde kleuren; "Altijd toestaan": omlijnd. */
    --im-btn-bg: var(--accent-tekst, var(--color-on-accent));
    --im-btn-color: var(--accent);
    --im-btn-hover-bg: color-mix(in oklch, var(--accent-tekst, var(--color-on-accent)) 85%, var(--accent));
    --im-btn-active-box-shadow: 0 0 0 0.25em color-mix(in oklch, var(--accent-tekst, var(--color-on-accent)) 35%, transparent);
    --im-btn-s-bg: transparent;
    --im-btn-s-color: var(--accent-tekst, var(--color-on-accent));
    --im-btn-s-hover-bg: color-mix(in oklch, var(--accent-tekst, var(--color-on-accent)) 15%, transparent);
    --im-btn-s-active-bg: color-mix(in oklch, var(--accent-tekst, var(--color-on-accent)) 25%, transparent);
  }
  div[data-service] .cll .c-n-a button {
    border-radius: 999px;
    box-shadow: none;
    font-family: var(--font-sans);
  }
  div[data-service] .cll .c-n-a .c-la-b {
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  div[data-service] .cll .c-n-a button:focus-visible,
  div[data-service] .cll a:focus-visible {
    outline: 2px solid var(--im-color);
    outline-offset: 3px;
  }
  div[data-service] .cll a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    div[data-service] .cll * {
      transition: none !important;
    }
  }

  /* Consent-UI volgt de site-tokens (ook in donkere modus). */
  #cc-main {
    --cc-font-family: var(--font-sans);
    --cc-bg: var(--color-bg);
    --cc-primary-color: var(--color-fg);
    --cc-secondary-color: var(--color-muted);
    --cc-btn-primary-bg: var(--color-fg);
    --cc-btn-primary-color: var(--color-bg);
    --cc-btn-primary-border-color: var(--color-fg);
    --cc-btn-primary-hover-bg: var(--color-muted);
    --cc-btn-primary-hover-border-color: var(--color-muted);
    --cc-btn-secondary-bg: var(--color-surface);
    --cc-btn-secondary-color: var(--color-fg);
    --cc-btn-secondary-border-color: var(--color-line);
    --cc-btn-secondary-hover-bg: var(--color-line);
    --cc-separator-border-color: var(--color-line);
    --cc-toggle-on-bg: var(--color-fg);
    --cc-toggle-on-knob-bg: var(--color-bg);
    --cc-toggle-off-bg: var(--color-muted);
    --cc-toggle-off-knob-bg: var(--color-bg);
    --cc-toggle-enabled-icon-color: var(--color-fg);
    --cc-toggle-disabled-icon-color: var(--color-muted);
    --cc-toggle-readonly-bg: var(--color-line);
    --cc-toggle-readonly-knob-bg: var(--color-bg);
    --cc-toggle-readonly-knob-icon-color: var(--color-muted);
    /* Ook bij hover en open: de standaard is een licht vlak, waarop witte tekst (donkere modus) wegvalt. */
    --cc-cookie-category-block-bg: var(--color-surface);
    --cc-cookie-category-block-border: var(--color-line);
    --cc-cookie-category-block-hover-bg: var(--color-line);
    --cc-cookie-category-block-hover-border: var(--color-line);
    --cc-cookie-category-expanded-block-bg: var(--color-surface);
    --cc-cookie-category-expanded-block-hover-bg: var(--color-line);
    --cc-section-category-border: var(--color-line);
    --cc-footer-bg: var(--color-bg);
    --cc-footer-color: var(--color-muted);
    --cc-footer-border-color: var(--color-line);
    --cc-link-color: var(--color-fg);
    --cc-overlay-bg: oklch(0% 0 0 / 0.6);
    --cc-modal-border-radius: var(--radius);
    --cc-btn-border-radius: var(--radius);
  }
</style>
