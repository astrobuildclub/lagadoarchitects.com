---
// <head>-meta: titel, beschrijving, canonical, Open Graph, Twitter, JSON-LD.
// Alles hier zonder stega-tekens (Visual Editing): zoekmachines en deelkaarten lezen dit letterlijk.
import { stegaClean } from '@sanity/client/stega';
import { croppedUrl } from '../lib/sanity/image';
import { cleanPath } from '../lib/url';
import type { SanityImage, Settings } from '../lib/schema';

interface Props {
  settings: Settings;
  title: string;
  description: string;
  image?: SanityImage;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
}

const { settings, title, description, image, imageAlt, type = 'website', noindex = false, jsonLd = [] } = Astro.props;
const site = settings.url;
const canonical = new URL(cleanPath(Astro.url.pathname), site).href;

// Deelbeeld: pagina → site-instellingen → /og-default.png (1200×630)
const shareSrc = image ?? settings.seo.deelAfbeelding?.src;
const shareAlt = stegaClean(image ? imageAlt : settings.seo.deelAfbeelding?.alt);
// Bijgesneden rond de hotspot uit de Studio.
const ogUrl = shareSrc ? croppedUrl(shareSrc, 1200, 630) : new URL('/og-default.png', site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={stegaClean(settings.siteNaam)} />
<meta property="og:locale" content="nl_NL" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{shareAlt && <meta property="og:image:alt" content={shareAlt} />}
<meta name="twitter:card" content="summary_large_image" />

{jsonLd.map((data) => <script type="application/ld+json" set:html={stegaClean(JSON.stringify(data))} />)}
