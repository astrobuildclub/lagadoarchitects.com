---
import Img from './Img.astro';
import RichText from './RichText.astro';
import type { ImageRef, RichText as RichTextValue } from '../lib/schema';

interface Props {
  title: string;
  /** Portable Text uit Sanity, of een vaste zin (404). */
  intro?: RichTextValue | string;
  /** Intro over de volle breedte van de container in plaats van max 32ch (/projecten). */
  breed?: boolean;
  /** Figma "Over": titel als klein label (step--1, vet), intro groot over de volle breedte. */
  label?: boolean;
  /** Breed beeld onder de intro (3:2). */
  beeld?: ImageRef;
}
const { title, intro, breed = false, label = false, beeld } = Astro.props;
// Een link naar `#verras` in de intro wordt de knop "Verras me" van de projectfilters (richtext/Link.astro).
---

<header class:list={['page-header', label && 'page-header--label feature']}>
  <h1>{title}</h1>
  {intro?.length ? (
    <div class:list={['page-header__intro', (breed || label) && 'page-header__intro--breed']}>
      {typeof intro === 'string' ? <p>{intro}</p> : <RichText value={intro} />}
    </div>
  ) : null}
  {beeld?.src && (
    <figure class="page-header__beeld">
      <Img src={beeld.src} alt={beeld.alt} sizes="(min-width: 80rem) 78rem, 100vw" priority />
      {beeld.caption && <figcaption>{beeld.caption}</figcaption>}
    </figure>
  )}
</header>

<style>
  .page-header {
    padding-block-start: var(--page-top);
  }
  .page-header__intro :global(.verras) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }
  .page-header__intro :global(.verras:enabled) {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .page-header__intro :global(.verras:enabled:hover) {
    text-decoration-thickness: 3px;
  }
  .page-header__intro :global(.verras:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .page-header__intro {
    margin-block-start: var(--space-s);
    font-size: var(--step-2);
    line-height: 1.3;
    max-inline-size: 32ch;
  }
  .page-header__intro--breed {
    max-inline-size: none;
  }
  /* Label-variant (Over): klein vet label, intro step-2 / 1.2 over de volle breedte. */
  .page-header--label h1 {
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0;
  }
  .page-header--label .page-header__intro {
    margin-block-start: var(--space-xs);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .page-header__beeld {
    margin-block-start: var(--space-3xl);
  }
  .page-header__beeld img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .page-header__beeld figcaption {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-muted);
  }
  /* Eerste alinea groot; volgende alinea's kleiner op een eigen regel (bv. de filterzin op /projecten). */
  .page-header__intro :global(p + p) {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-0);
    line-height: 1.5;
  }
</style>
