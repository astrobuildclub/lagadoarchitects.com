---
import RichText from './RichText.astro';
import type { RichText as RichTextValue } from '../lib/schema';

interface Props {
  title: string;
  /** Portable Text uit Sanity, of een vaste zin (404). */
  intro?: RichTextValue | string;
  /** Intro over de volle breedte van de container in plaats van max 32ch (/projecten). */
  breed?: boolean;
}
const { title, intro, breed = false } = Astro.props;
// Een link naar `#verras` in de intro wordt de knop "Verras me" van de projectfilters (richtext/Link.astro).
---

<header class="page-header">
  <h1>{title}</h1>
  {intro?.length ? (
    <div class:list={['page-header__intro', breed && 'page-header__intro--breed']}>
      {typeof intro === 'string' ? <p>{intro}</p> : <RichText value={intro} />}
    </div>
  ) : null}
</header>

<style>
  .page-header {
    padding-block-start: var(--page-top);
  }
  .page-header__intro :global(.verras) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }
  .page-header__intro :global(.verras:enabled) {
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .page-header__intro :global(.verras:enabled:hover) {
    text-decoration-thickness: 3px;
  }
  .page-header__intro :global(.verras:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .page-header__intro {
    margin-block-start: var(--space-s);
    font-size: var(--step-2);
    line-height: 1.3;
    max-inline-size: 32ch;
  }
  .page-header__intro--breed {
    max-inline-size: none;
  }
  /* Eerste alinea groot; volgende alinea's kleiner op een eigen regel (bv. de filterzin op /projecten). */
  .page-header__intro :global(p + p) {
    margin-block-start: var(--space-2xs);
    font-size: var(--step-0);
    line-height: 1.5;
  }
</style>
