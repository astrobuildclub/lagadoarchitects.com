---
// Kaart in een projectraster, met type • jaar en titel. Twee varianten (Figma):
// - Home (`sized`, 447:2103): de foto vult de kaart, daarop een vorm in de projectkleur met de tekst.
//   Hover (muis) of in beeld (touch) keert dat om: de kaart krijgt de kleur, de foto krimpt tot de vorm.
// - /projecten (`vlak`, 462:8670): de foto in de kaartvorm met de tekst eronder; hover kleurt de kaart.
// Met de muis horizontaal scrubben door de beelden (project-card.ts).
// De data-*-attributen voeden de filters op /projecten.
import Img from './Img.astro';
import { projectBeelden, projectImage } from '../lib/images';
import { kaartkleur } from '../lib/projectkleur';
import { label } from '../lib/labels';
import type { Project } from '../lib/schema';

interface Props {
  project: Project;
  headingLevel?: 2 | 3;
  priority?: boolean;
  /** Homepage-raster: 1 of 2 rijen hoog volgens homepageGrootte. */
  sized?: boolean;
  /** /projecten-raster: kaart in de projectkleur met de foto in de kaartvorm en de tekst eronder. */
  vlak?: boolean;
  /** Pas zichtbaar na "Meer projecten". */
  later?: boolean;
}
const { project: p, headingLevel = 3, priority = false, sized = false, vlak = sized, later = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const grootte = sized ? p.homepageGrootte : undefined;
// /projecten: geen vlak in de vorm, maar een kaart waarin de foto de vorm heeft.
const kaart = vlak && !sized;
// Eerste vorm uit het filter; zonder vorm een rechthoek.
const vorm = p.vorm[0] ?? 'recht';
// Homeraster: eigen kaartvorm, anders afgeleid van de vorm (styles/vorm.css).
const kaartvormVanVorm = { rond: 'ovaal', recht: 'zacht', schuin: 'schuin' } as const;
const kaartvorm = vlak ? (p.kaartvorm ?? kaartvormVanVorm[vorm]) : undefined;
// 0 is een invulplek in de content, geen jaar.
const jaar = p.jaarOplevering || p.jaarOpdracht || undefined;
const kleur = await kaartkleur(p);
const [, ...meer] = projectBeelden(p);
// Home: 1 kolom, vanaf 36rem 2, vanaf 60rem 3. /projecten: 1 kolom, vanaf 36rem 2, 60rem 3, 105rem 4, 140rem 5 (ProjectList.astro).
const sizes = sized
  ? '(min-width: 60rem) 30vw, (min-width: 36rem) 45vw, 90vw'
  : kaart
    ? '(min-width: 140rem) 17vw, (min-width: 105rem) 21vw, (min-width: 60rem) 28vw, (min-width: 36rem) 42vw, 85vw'
    : '(min-width: 60rem) 33vw, (min-width: 36rem) 50vw, 100vw';
const filters = {
  type: p.type,
  vorm: p.vorm.join(' '),
  kleuren: p.kleuren.join(' '),
  status: p.status,
  schaal: p.schaal ?? '',
  materialen: p.materialen.join(' '),
  opgave: p.opgave.join(' '),
  prijsklasse: p.prijsklasse ?? '',
};
---

<li
  class:list={['project-card', sized && 'project-card--vlak', kaart && 'project-card--kaart', grootte && `project-card--${grootte}`]}
  data-vorm={vorm}
  data-kaartvorm={kaartvorm}
  data-later={later || undefined}
  hidden={later}
  style={`--kaart-vlak: ${kleur.vlak}; --kaart-tekst: ${kleur.tekst}`}
  {...Object.fromEntries(Object.entries(filters).map(([k, v]) => [`data-${k}`, v]))}
>
  <a href={`/projecten/${p.slug}`}>
    <div class="project-card__vorm">
      <div class="project-card__beelden">
        <Img src={projectImage(p.slug, p.hero.src)} alt={p.hero.alt} sizes={sizes} priority={priority} class="project-card__beeld is-actief" />
        {
          meer.length > 0 && (
            <template data-meer-beelden>
              {meer.map((src) => (
                <Img src={projectImage(p.slug, src)} alt="" sizes={sizes} class="project-card__beeld" />
              ))}
            </template>
          )
        }
      </div>
      {
        meer.length > 0 && (
          <span class="project-card__scrub" aria-hidden="true">
            {[p.hero.src, ...meer].map((_, i) => <span class:list={[i === 0 && 'is-actief']} />)}
          </span>
        )
      }
      <div class="project-card__tekst">
        <div class="project-card__voet">
          <p class="project-card__label">{label(p.type)}{jaar && ` • ${jaar}`}</p>
          <Heading class="project-card__title">{p.title}</Heading>
        </div>
      </div>
    </div>
  </a>
  <p class="project-card__tagline">{p.tagline}</p>
  <p class="project-card__meta muted">
    {p.locatie.plaats} · {label(p.programma)}{jaar ? ` · ${jaar}` : ''}
  </p>
</li>


<style>
  .project-card a {
    display: block;
    block-size: 100%;
    text-decoration: none;
    border-radius: var(--space-xs);
  }

  .project-card__vorm {
    position: relative;
    overflow: hidden;
    block-size: 100%;
    color: var(--kaart-tekst);
  }

  .project-card__beelden,
  .project-card__beelden :global(img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  /* Tussen de beelden (scrubben) wisselt het hard. */
  .project-card__beelden :global(img:not(.is-actief)) {
    visibility: hidden;
  }

  .project-card__voet {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .project-card__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.125;
  }
  /* Type • jaar: klein, mono, kapitalen (Figma). Buiten het raster alleen voor schermlezers. */
  .project-card__label {
    clip-path: inset(50%);
    position: absolute;
    block-size: 1px;
    inline-size: 1px;
    overflow: hidden;
    white-space: nowrap;
  }
  :global([data-view='raster']) :is(.project-card--vlak, .project-card--kaart) .project-card__label {
    position: static;
    clip-path: none;
    inline-size: auto;
    block-size: auto;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }

  .project-card__scrub {
    position: absolute;
    inset-block-end: var(--space-xs);
    inset-inline: 0;
    display: flex;
    justify-content: center;
    gap: var(--space-3xs);
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }
  .project-card__scrub span {
    inline-size: var(--space-s);
    block-size: 2px;
    background: oklch(99% 0 0 / 0.5);
  }
  .project-card__scrub span.is-actief {
    background: oklch(99% 0 0);
  }
  @media (hover: hover) {
    :global([data-view='raster']) .project-card:not(.project-card--vlak):hover .project-card__scrub {
      opacity: 1;
    }
  }

  /* ── Home (Figma 447:2103) ─────────────────────────────────────────────
     De foto vult de kaart (radius xs); daarop, op --kaart-pad afstand, de vorm in de projectkleur
     met de tekst gecentreerd. Omgekeerd bij hover/focus (muis) of in beeld (touch): de kaart wordt
     de kleur en de foto krimpt via clip-path tot precies de vorm; inset() en polygon() animeren
     vloeiend tussen de twee standen. */
  .project-card--vlak {
    --kaart-pad: var(--space-s);
    --foto-rust: inset(0 round var(--space-xs));
    --foto-vorm: inset(var(--kaart-pad) round var(--vorm-radius));
  }
  /* Schuin: zelfde parallellogram als de vorm, maar binnen de marge. In rust een gewone rechthoek
     met vier punten, zodat het overgaat in plaats van verspringt. */
  .project-card--vlak[data-kaartvorm='schuin'] {
    --foto-rust: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    --foto-vorm: polygon(
      calc(var(--kaart-pad) + var(--vorm-schuin)) var(--kaart-pad),
      calc(100% - var(--kaart-pad)) var(--kaart-pad),
      calc(100% - var(--kaart-pad) - var(--vorm-schuin)) calc(100% - var(--kaart-pad)),
      var(--kaart-pad) calc(100% - var(--kaart-pad))
    );
  }
  @media (min-width: 60rem) {
    .project-card--vlak {
      --kaart-pad: var(--space-l);
    }
  }
  .project-card--vlak .project-card__vorm {
    border-radius: var(--space-xs);
    background: var(--kaart-vlak);
  }
  .project-card--vlak .project-card__beelden {
    clip-path: var(--foto-rust);
    transition: clip-path calc(var(--duration) * 2) var(--ease);
  }
  .project-card--vlak .project-card__tekst {
    position: absolute;
    inset: var(--kaart-pad);
    display: grid;
    place-items: center;
    padding: var(--space-m) var(--space-l);
    background: var(--kaart-vlak);
    border-radius: var(--vorm-radius);
    clip-path: var(--vorm-clip);
    transition: opacity var(--duration) var(--ease);
  }
  .project-card--vlak .project-card__voet {
    gap: var(--space-2xs);
  }
  .project-card--vlak .project-card__title {
    font-size: var(--step-2);
  }
  :global([data-view='raster']) .project-card--vlak .project-card__label {
    font-size: var(--step-0);
  }
  /* Tekst een stap groter dan in Figma (meta step-0, titel step-2). Kaarten van 1 rij: meta een stap
     kleiner, meer lucht tussen meta en titel. */
  .project-card--vlak:not(.project-card--hoog, .project-card--toren, .project-card--groot) .project-card__voet {
    gap: var(--space-xs);
  }
  :global([data-view='raster']) .project-card--vlak:not(.project-card--hoog, .project-card--toren, .project-card--groot) .project-card__label {
    font-size: var(--step--1);
  }
  /* Home: geen scrubbalk; het beeld wisselt vanzelf (project-card.ts). */
  .project-card--vlak .project-card__scrub {
    display: none;
  }
  @media (hover: hover) {
    .project-card--vlak:is(:hover, :focus-within) .project-card__beelden {
      clip-path: var(--foto-vorm);
    }
    .project-card--vlak:is(:hover, :focus-within) .project-card__tekst {
      opacity: 0;
    }
  }
  @media (hover: none) {
    .project-card--vlak.is-open .project-card__beelden {
      clip-path: var(--foto-vorm);
    }
    .project-card--vlak.is-open .project-card__tekst {
      opacity: 0;
    }
  }

  /* ── /projecten (Figma 462:8670) ───────────────────────────────────────
     De foto staat in de kaartvorm (3:4), de tekst eronder. Standaard zonder vlak, in de tekstkleur
     van de pagina; bij hover, focus of in beeld (touch) krijgt de kaart de projectkleur, met zwart of
     wit op contrast (kaartkleur, WCAG 1.4.3). Alleen in de rasterweergave; de lijst staat in ProjectList. */
  :global([data-view='raster']) .project-card--kaart .project-card__vorm {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-l);
    border-radius: var(--space-xs);
    background: transparent;
    color: var(--color-fg);
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  @media (hover: hover) {
    :global([data-view='raster']) .project-card--kaart:is(:hover, :focus-within) .project-card__vorm {
      background: var(--kaart-vlak);
      color: var(--kaart-tekst);
    }
  }
  @media (hover: none) {
    :global([data-view='raster']) .project-card--kaart.is-open .project-card__vorm {
      background: var(--kaart-vlak);
      color: var(--kaart-tekst);
    }
  }
  :global([data-view='raster']) .project-card--kaart :is(.project-card__beelden, .project-card__scrub) {
    grid-area: 1 / 1;
  }
  :global([data-view='raster']) .project-card--kaart .project-card__beelden {
    position: relative;
    aspect-ratio: 3 / 4;
    block-size: auto;
    overflow: hidden;
    border-radius: var(--vorm-radius);
    clip-path: var(--vorm-clip);
  }
  :global([data-view='raster']) .project-card--kaart .project-card__scrub {
    position: static;
    align-self: end;
    margin-block-end: var(--space-xs);
  }
  :global([data-view='raster']) .project-card--kaart .project-card__voet {
    gap: var(--space-2xs);
  }
  :global([data-view='raster']) .project-card--kaart .project-card__title {
    font-size: var(--step-3);
  }

  .project-card__tagline,
  .project-card__meta {
    display: none;
  }
  .project-card__meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
