---
// Eén plek voor responsive beeld: Sanity-beeld → <img srcset> via de Sanity-CDN (standards/IMAGES.md).
// `sizes` per context meegeven. width/height altijd gezet (geen layout shift).
import { focalPoint, imageProps } from '../lib/sanity/image';
import type { SanityImage } from '../lib/schema';

interface Props {
  src: SanityImage;
  alt: string;
  sizes?: string;
  widths?: number[];
  /** Alleen voor het LCP-beeld bovenaan de pagina. */
  priority?: boolean;
  class?: string;
}

const { src, alt, sizes = '100vw', widths, priority = false, class: className } = Astro.props;
const img = imageProps(src, { sizes, widths });
// Met CSS bijgesneden beelden (object-fit: cover) volgen het focuspunt uit de Studio.
const positie = focalPoint(src);
---

<img
  {...img}
  alt={alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding={priority ? 'sync' : 'async'}
  class={className}
  style={positie ? `object-position: ${positie}` : undefined}
/>
