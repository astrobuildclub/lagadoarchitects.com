---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '../lib/schema';

interface Props {
  projects: Project[];
  headingLevel?: 2 | 3;
  id?: string;
  /** Homepage: kaarten per homepageGrootte in een raster met spans. */
  sized?: boolean;
  /** Zoveel kaarten eerst; de rest wacht op "Meer projecten" (ProjectGrid). */
  zichtbaar?: number;
  /** /projecten: raster of lijst (wisselknop in ProjectFilter). In de lijst hangt het beeld aan de muis. */
  weergave?: boolean;
}
const { projects, headingLevel, id, sized = false, weergave = false, zichtbaar } = Astro.props;
---

<div>
  <ul role="list" class:list={['project-list', sized && 'project-list--sized', weergave && 'project-list--vlak']} id={id} data-view="raster">
    {projects.map((project, i) => (
      <ProjectCard
        project={project}
        headingLevel={headingLevel}
        priority={i < 2}
        sized={sized}
        vlak={sized || weergave}
        later={zichtbaar !== undefined && i >= zichtbaar}
      />
    ))}
  </ul>
</div>
{
  weergave && id && (
    <div class="project-hover" data-hover-follow={id} aria-hidden="true">
      <img alt="" sizes="20rem" decoding="async" />
    </div>
  )
}

<script>
  import '../scripts/hover-follow';
  import '../scripts/project-card';
</script>

<style>
  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-l) var(--space-s);
  }

  /* Lijst: één rij per project, zonder beeld (dat hangt bij hover aan de muis, zie
     hover-follow.ts). De hele rij is klikbaar via de titellink (::after over de rij). */
  .project-list[data-view='lijst'] {
    display: block;
  }
  .project-list[data-view='lijst'] :global(.project-card) {
    position: relative;
    display: grid;
    gap: var(--space-3xs) var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .project-list[data-view='lijst'] :global(.project-card[hidden]) {
    display: none;
  }
  /* Vlak, beelden en jaar weg; de titel blijft als gewone tekst in de rij staan. */
  .project-list[data-view='lijst'] :global(:is(.project-card__beelden, .project-card__boven)) {
    display: none;
  }
  .project-list[data-view='lijst'] :global(:is(.project-card__vorm, .project-card__tekst, .project-card__voet)) {
    position: static;
    display: block;
    aspect-ratio: auto;
    padding: 0;
    background: none;
    color: inherit;
    border-radius: 0;
    clip-path: none;
    text-align: start;
    justify-items: start;
  }
  .project-list[data-view='lijst'] :global(:is(.project-card__tagline, .project-card__meta)) {
    display: block;
  }
  .project-list[data-view='lijst'] :global(.project-card a::after) {
    content: '';
    position: absolute;
    inset: 0;
  }
  .project-list[data-view='lijst'] :global(.project-card__title),
  .project-list[data-view='lijst'] :global(.project-card__tagline) {
    margin: 0;
  }
  .project-list[data-view='lijst'] :global(.project-card:hover .project-card__title) {
    text-decoration: underline;
  }
  @media (min-width: 48rem) {
    .project-list[data-view='lijst'] :global(.project-card) {
      grid-template-columns: 3fr 4fr 3fr;
      align-items: baseline;
    }
    .project-list[data-view='lijst'] :global(.project-card__meta) {
      text-align: end;
    }
  }

  .project-hover {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 20;
    inline-size: clamp(12rem, 22vw, 22rem);
    aspect-ratio: 4 / 3;
    pointer-events: none;
    visibility: hidden;
  }
  .project-hover img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  /* Zelfde vorm als de kaart (data-vorm wordt gezet door hover-follow.ts, zie styles/vorm.css). */
  .project-hover img {
    border-radius: var(--vorm-radius, 0);
    clip-path: var(--vorm-clip, none);
  }

  /* Homeraster (Figma 447:2103): 1 kolom, vanaf 36rem 2, vanaf 60rem 3, alle kaarten even breed.
     Rijhoogte schaalt mee (≈ 228px op 1512); hoog, toren en groot beslaan 2 rijen, de rest 1.
     ProjectGrid maakt het aantal cellen deelbaar door 6, `dense` vult de gaten; de tabvolgorde blijft die van de content. */
  .project-list--sized {
    grid-template-columns: repeat(var(--kolommen, 1), 1fr);
    grid-auto-rows: clamp(11rem, 15vw, 18rem);
    grid-auto-flow: dense;
    gap: var(--tile-gap);
  }
  .project-list--sized :global(:is(.project-card--hoog, .project-card--toren, .project-card--groot)) {
    grid-row: span 2;
  }
  @media (min-width: 36rem) {
    .project-list--sized {
      --kolommen: 2;
    }
  }
  @media (min-width: 60rem) {
    .project-list--sized {
      --kolommen: 3;
    }
  }
  /* /projecten, rasterweergave (Figma 462:8670): staande kaarten (ProjectCard --kaart), gap l, 1 kolom, oplopend tot 5 op grote schermen. */
  .project-list--vlak[data-view='raster'] {
    grid-template-columns: repeat(var(--kolommen, 1), 1fr);
    align-items: start;
    gap: var(--space-l);
  }
  @media (min-width: 36rem) {
    .project-list--vlak[data-view='raster'] {
      --kolommen: 2;
    }
  }
  @media (min-width: 60rem) {
    .project-list--vlak[data-view='raster'] {
      --kolommen: 3;
    }
  }
  @media (min-width: 105rem) {
    .project-list--vlak[data-view='raster'] {
      --kolommen: 4;
    }
  }
  @media (min-width: 140rem) {
    .project-list--vlak[data-view='raster'] {
      --kolommen: 5;
    }
  }
</style>
