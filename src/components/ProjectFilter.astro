---
// Filters voor /wat. Progressive enhancement: zonder JS staat alles zichtbaar en zijn
// de filters verborgen. Met JS: kaarten krijgen `hidden`, keuze staat in de querystring
// (deelbaar, werkt met terug-knop), aantal resultaten wordt voorgelezen.
// Binnen één groep = OF, tussen groepen = EN. Elke optie toont hoeveel projecten je
// overhoudt als je hem aanzet; bij 0 is hij uitgeschakeld, dus je komt nooit op niets uit.
//
// Opbouw als het factsheet op de projectpagina: één rij per groep, label (mono) links in
// een vaste kolom, opties ernaast als kale tekst (actief = onderstreept). Volgorde volgens
// Victor: Type, Vorm, Kleur (swatches, direct zichtbaar); Status, Schaal en Materiaal
// onder "Tot op de mm". Daaronder één actieregel: Tot op de mm en Wis filters (alleen als
// er iets aan staat). "Verras me" is het woord "verrassen" in de intro (link naar #verras
// in site.md). Aantal projecten en Raster / Lijst staan op één regel boven de lijst.
// Mobiel (< 40rem): de rijen staan in een overlay achter de knop "Filters", alle rijen open.
import { KLEUR_SWATCH, label } from '../lib/labels';
import { KLEUR, MATERIAAL, SCHAAL, STATUS, TYPE, VORM, type Project } from '../lib/schema';

interface Props {
  projects: Project[];
  toonPrijs: boolean;
  target: string;
}
const { projects, toonPrijs, target } = Astro.props;

interface Group {
  key: string;
  legend: string;
  values: string[];
}

/** Alleen waarden die in de projecten voorkomen, in de volgorde van de waardenlijst. */
const group = (key: string, legend: string, order: readonly string[], used: string[]): Group => ({
  key,
  legend,
  values: order.filter((v) => used.includes(v)),
});

const main = [
  group('type', 'Type', TYPE, projects.map((p) => p.type)),
  group('vorm', 'Vorm', VORM, projects.flatMap((p) => p.vorm)),
  group('kleuren', 'Kleur', KLEUR, projects.flatMap((p) => p.kleuren)),
];
const extra = [
  group('status', 'Status', STATUS, projects.map((p) => p.status)),
  group('schaal', 'Schaal', SCHAAL, projects.flatMap((p) => (p.schaal ? [p.schaal] : []))),
  group('materialen', 'Materiaal', MATERIAAL, projects.flatMap((p) => p.materialen)),
  ...(toonPrijs
    ? [group('prijsklasse', 'Prijsklasse', ['laag', 'midden', 'hoog'], projects.flatMap((p) => (p.prijsklasse ? [p.prijsklasse] : [])))]
    : []),
];
// Een filter met één waarde filtert niets.
const useful = (g: Group) => g.values.length > 1;
const mainGroups = main.filter(useful);
const extraGroups = extra.filter(useful);
const hasFilters = mainGroups.length + extraGroups.length > 0;
---

<form class="project-filter" data-project-filter data-target={target} hidden aria-label="Projecten filteren">
  {
    hasFilters ? (
      <dialog class="project-filter__panel" aria-labelledby="project-filter-titel" data-panel>
        <div class="project-filter__head">
          <h2 id="project-filter-titel">Filters</h2>
          <button type="button" class="project-filter__close" aria-label="Filters sluiten" data-close>
            <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
              <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.75" />
            </svg>
          </button>
        </div>
        <div class="project-filter__body">
          {[mainGroups, extraGroups].map(
            (groups, i) =>
              groups.length > 0 && (
                <div class:list={['project-filter__groups', i === 1 && 'project-filter__extra']} id={i === 1 ? 'filter-extra' : undefined} data-extra={i === 1 ? '' : undefined}>
                  {groups.map((g) => (
                    <div class="project-filter__group" role="group" aria-labelledby={`filter-${g.key}`}>
                      <span class="project-filter__label" id={`filter-${g.key}`}>
                        {g.legend}
                      </span>
                      <div class="options">
                        {g.values.map((v) => (
                          <label class="option">
                            <input type="checkbox" name={g.key} value={v} />
                            {g.key === 'kleuren' && <span class="swatch" style={`--swatch: ${KLEUR_SWATCH[v]}`} aria-hidden="true" />}
                            <span class="option__label">{label(v)}</span>
                            <span class="option__n" data-n />
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ),
          )}
        </div>
        <div class="project-filter__foot">
          <button type="button" class="button project-filter__show" data-close data-show-count>Toon projecten</button>
        </div>
      </dialog>
    ) : (
      <p class="muted">Filters verschijnen zodra er meer projecten zijn.</p>
    )
  }
  <div class="project-filter__bar">
    {
      hasFilters && (
        <button type="button" class="action project-filter__open" aria-haspopup="dialog" data-open>
          <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
            <path d="M2 4h12M4 8h8M6 12h4" fill="none" stroke="currentColor" stroke-width="1.75" />
          </svg>
          Filters <span class="n" data-active-count />
        </button>
      )
    }
    {
      extraGroups.length > 0 && (
        <button type="button" class="action project-filter__more" aria-expanded="false" aria-controls="filter-extra" data-more>
          Tot op de mm
          <svg class="chevron" aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
            <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.75" />
          </svg>
        </button>
      )
    }
    <button type="reset" class="action" data-reset hidden>Wis filters</button>
  </div>
</form>

<script>
  // Document-listeners (overlay, breakpoint, transitie) per pagina opnieuw koppelen, oude opruimen.
  let controller: AbortController | undefined;

  function initFilter() {
    controller?.abort();
    const form = document.querySelector<HTMLFormElement>('[data-project-filter]');
    if (!form) return;
    controller = new AbortController();
    const { signal } = controller;
    const list = document.getElementById(form.dataset.target!)!;
    const cards = [...list.querySelectorAll<HTMLElement>('.project-card')];
    // Aantal staat boven de lijst (wat/index.astro), verras-knop in de intro (PageHeader).
    const count = document.querySelector(`[data-count="${form.dataset.target}"]`);
    const extra = form.querySelector<HTMLElement>('[data-extra]');
    const moreButton = form.querySelector<HTMLButtonElement>('[data-more]');
    const resetButton = form.querySelector<HTMLButtonElement>('[data-reset]')!;
    const panel = form.querySelector<HTMLDialogElement>('[data-panel]');
    const activeCount = form.querySelector('[data-active-count]');
    const showCount = form.querySelector('[data-show-count]');
    const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    form.hidden = false;

    const own = (card: HTMLElement, key: string) => (card.dataset[key] ?? '').split(' ').filter(Boolean);
    const matches = (card: HTMLElement, active: Map<string, string[]>, skip?: string) =>
      [...active].every(([key, values]) => key === skip || values.some((v) => own(card, key).includes(v)));

    // "Tot op de mm": extra rijen tonen of verbergen (op mobiel staan ze in de overlay altijd open).
    const setMore = (open: boolean) => {
      if (!extra || !moreButton) return;
      extra.classList.toggle('is-open', open);
      moreButton.setAttribute('aria-expanded', String(open));
    };
    moreButton?.addEventListener('click', () => setMore(moreButton.getAttribute('aria-expanded') !== 'true'));

    const apply = (updateUrl: boolean) => {
      const data = new FormData(form);
      const active = new Map<string, string[]>();
      for (const [k, v] of data) active.set(k, [...(active.get(k) ?? []), String(v)]);

      let visible = 0;
      for (const card of cards) {
        const match = matches(card, active);
        card.hidden = !match;
        if (match) visible++;
      }
      const projecten = `${visible} ${visible === 1 ? 'project' : 'projecten'}`;
      if (count) count.textContent = projecten;
      if (showCount) showCount.textContent = `Toon ${projecten}`;
      const n = inputs.filter((i) => i.checked).length;
      if (activeCount) activeCount.textContent = n ? String(n) : '';
      resetButton.hidden = n === 0;

      // Facetten: per optie het aantal projecten dat aan alle andere groepen voldoet én deze
      // waarde heeft. 0 = uitgeschakeld. Aangevinkte opties blijven altijd bedienbaar, zodat
      // je ze (ook vanuit een oude URL) kunt uitzetten.
      for (const input of inputs) {
        const hits = cards.filter((card) => matches(card, active, input.name) && own(card, input.name).includes(input.value)).length;
        input.disabled = !input.checked && hits === 0;
        const badge = input.parentElement!.querySelector('[data-n]');
        if (badge) badge.textContent = String(hits);
      }

      // "Tot op de mm" open houden zolang daar iets aan staat.
      if (extra?.querySelector('input:checked')) setMore(true);

      if (updateUrl) {
        const params = new URLSearchParams(data as unknown as Record<string, string>);
        history.replaceState(history.state, '', params.size ? `?${params}` : location.pathname);
      }
    };

    // Verras me: kies een willekeurig project en zet 1–3 van zijn eigen filterwaarden aan.
    // Zo levert de combinatie altijd minstens één project op. Niet twee keer dezelfde combi.
    const groups = [...new Set(inputs.map((i) => i.name))];
    let previous = '';
    const random = <T,>(items: T[]) => items[Math.floor(Math.random() * items.length)];
    const surprise = () => {
      for (let attempt = 0; attempt < 20; attempt++) {
        const card = random(cards);
        const options = groups
          .map((key) => ({ key, values: own(card, key).filter((v) => inputs.some((i) => i.name === key && i.value === v)) }))
          .filter((o) => o.values.length);
        if (!options.length) continue;
        const picked = options.sort(() => Math.random() - 0.5).slice(0, 1 + Math.floor(Math.random() * Math.min(3, options.length)));
        const choice = picked.map((o) => [o.key, random(o.values)] as const);
        const signature = choice.map((c) => c.join('=')).sort().join('&');
        if (signature === previous && attempt < 19) continue;
        previous = signature;
        inputs.forEach((i) => (i.checked = choice.some(([k, v]) => i.name === k && i.value === v)));
        apply(true);
        return;
      }
    };

    // Paneel: op mobiel een modale overlay achter de knop "Filters", op desktop gewoon in
    // de pagina. Desktop opent via het attribuut (niet show()), zodat de focus niet verspringt.
    if (panel) {
      const mobile = matchMedia('(width < 40rem)');
      const setMode = () => {
        if (panel.open) panel.close();
        if (!mobile.matches) panel.setAttribute('open', '');
      };
      mobile.addEventListener('change', setMode, { signal });
      setMode();
      form.querySelector('[data-open]')?.addEventListener('click', () => panel.showModal());
      form.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => panel.close()));
      // Escape mag het paneel op desktop niet laten verdwijnen.
      panel.addEventListener('cancel', (e) => {
        if (!panel.matches(':modal')) e.preventDefault();
      });
      // Een modale <dialog> ligt boven de transitielaag: dicht vóór de pagina wordt bedekt.
      document.addEventListener(
        'interlude:leave',
        () => {
          if (panel.matches(':modal')) panel.close();
        },
        { signal },
      );
    }

    // Weergave: raster of lijst. Zet `data-view` op de lijst; de keuze blijft per bezoeker
    // bewaard (localStorage, mag ontbreken of falen: dan raster).
    // De knoppen staan boven de lijst (wat/index.astro), naast het aantal; zonder JS verborgen.
    const viewGroup = document.querySelector<HTMLElement>(`[data-view-for="${form.dataset.target}"]`);
    if (viewGroup) viewGroup.hidden = false;
    const viewButtons = [...(viewGroup?.querySelectorAll<HTMLButtonElement>('button[data-view]') ?? [])];
    const setView = (view: string) => {
      list.dataset.view = view;
      viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    };
    let savedView = 'raster';
    try {
      savedView = localStorage.getItem('wat-weergave') === 'lijst' ? 'lijst' : 'raster';
    } catch {}
    setView(savedView);
    viewButtons.forEach((b) =>
      b.addEventListener('click', () => {
        setView(b.dataset.view!);
        try {
          localStorage.setItem('wat-weergave', b.dataset.view!);
        } catch {}
      }),
    );

    // Startwaarden uit de URL
    const params = new URLSearchParams(location.search);
    inputs.forEach((input) => {
      input.checked = params.getAll(input.name).includes(input.value);
    });

    form.addEventListener('change', () => apply(true));
    form.addEventListener('reset', () => setTimeout(() => apply(true)));
    form.addEventListener('submit', (e) => e.preventDefault());
    document.querySelectorAll<HTMLButtonElement>('[data-random]').forEach((b) => {
      b.disabled = !cards.length;
      b.addEventListener('click', surprise, { signal });
    });
    apply(false);
  }

  document.addEventListener('astro:page-load', initFilter);
</script>

<style>
  .project-filter {
    display: grid;
    font-size: var(--step--1);
    border-block-start: var(--border-width) solid var(--color-line);
  }
  .project-filter[hidden] {
    display: none;
  }

  /* Rijen: label in een vaste kolom (mono, gedempt, zoals het factsheet), opties ernaast.
     Elke rij een dunne lijn eronder; alle opties beginnen op dezelfde lijn. */
  .project-filter__group {
    display: grid;
    grid-template-columns: 8rem 1fr;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: var(--space-3xs);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .project-filter__label {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }
  .project-filter__extra:not(.is-open) {
    display: none;
  }

  /* Opties en acties: kale tekst, actief = onderstreept. De checkbox blijft in de
     toegankelijkheidsboom (visueel weg); focus, aan en uitgeschakeld via :has(). */
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
  }
  .option,
  .action {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: 2rem; /* raakvlak ≥ 24px (WCAG 2.5.8) */
    cursor: pointer;
    user-select: none;
  }
  .option__label,
  .action {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--duration) var(--ease);
  }
  .option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: inherit;
  }
  .option:hover .option__label,
  .action:hover {
    text-decoration-color: var(--color-line);
  }
  .option:has(input:checked) .option__label,
  .action[aria-pressed='true'] {
    text-decoration-color: currentColor;
  }
  .option:has(input:focus-visible),
  .action:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .option:has(input:disabled) {
    cursor: not-allowed;
    color: var(--color-muted);
    opacity: 0.4;
  }
  .option:has(input:disabled):hover .option__label {
    text-decoration-color: transparent;
  }
  /* Aantal per optie, klein in mono: verklaart meteen waarom een optie uit staat. */
  .option__n,
  .n {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .swatch {
    inline-size: 0.9em;
    block-size: 0.9em;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: 0 0 0 1px var(--color-line);
  }

  /* Actieregel */
  .project-filter__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-m);
    padding-block: var(--space-2xs);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .action {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }
  .action[hidden] {
    display: none;
  }
  .project-filter__open {
    display: none;
  }
  .chevron {
    flex: none;
    transition: rotate var(--duration) var(--ease);
  }
  .project-filter__more[aria-expanded='true'] .chevron {
    rotate: 180deg;
  }

  /* Paneel. Desktop: gewoon in de pagina (dialog open via attribuut, niet modaal). */
  .project-filter__panel {
    position: static;
    margin: 0;
    padding: 0;
    border: 0;
    inline-size: auto;
    max-inline-size: none;
    max-block-size: none;
    background: none;
    color: inherit;
  }
  .project-filter__panel[open] {
    display: grid;
  }
  .project-filter__head,
  .project-filter__foot {
    display: none;
  }

  /* Mobiel: knop "Filters" in de actieregel, "Tot op de mm" niet (in de overlay staat alles open). */
  @media (width < 40rem) {
    .project-filter__open {
      display: inline-flex;
    }
    .project-filter__more {
      display: none;
    }
  }
  /* Overlay: schermvullend met kop, scrollende inhoud en een vaste knop onderaan.
     Label boven de opties in plaats van ernaast. */
  .project-filter__panel:modal {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100dvh;
    grid-template-rows: auto 1fr auto;
    background: var(--color-bg);
    color: var(--color-fg);
  }
  .project-filter__panel:modal .project-filter__extra {
    display: block;
  }
  .project-filter__panel:modal .project-filter__group {
    grid-template-columns: 1fr;
    gap: 0;
    padding-block: var(--space-xs);
  }
  .project-filter__panel:modal .project-filter__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2xs) var(--space-s);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .project-filter__head h2 {
    margin: 0;
    font-size: var(--step-1);
  }
  .project-filter__close {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-inline-end: calc(-1 * var(--space-xs));
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .project-filter__panel:modal .project-filter__body {
    align-content: start;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--space-s);
  }
  .project-filter__panel:modal .project-filter__foot {
    display: block;
    padding: var(--space-s);
    border-block-start: var(--border-width) solid var(--color-line);
  }
  .project-filter__show {
    inline-size: 100%;
    min-block-size: 2.75rem;
    justify-content: center;
  }
  :global(html:has(.project-filter__panel:modal)) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .option__label,
    .action,
    .chevron {
      transition: none;
    }
  }
</style>
