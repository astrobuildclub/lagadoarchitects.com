---
import { md } from '../../lib/markdown';
import { has, type BlockProps } from './scope';

type Props = BlockProps<'text'>;
const { block } = Astro.props;
const Heading = block.niveau === 3 ? 'h3' : 'h2';
---

<section class="text">
  {has(block.kop) && <Heading class="text__kop">{block.kop}</Heading>}
  <div class="prose" set:html={md(block.tekst)} />
</section>

<style>
  .text__kop {
    margin-block-end: var(--space-s);
  }
</style>
