---
import { has, type BlockProps } from './scope';

type Props = BlockProps<'downloads'>;
const { block } = Astro.props;
// `bestand` is de URL van het bestand in Sanity.
const items = block.items.map((d) => ({ ...d, url: d.bestand })).filter((d) => d.url);
---

{
  items.length > 0 && (
    <section class="downloads">
      {has(block.kop) && <h2>{block.kop}</h2>}
      <ul role="list">
        {items.map((d) => (
          <li>
            <a href={d.url} download>{d.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}
