---
// Diensten of principes, in drie weergaven:
// - raster (zoals voorheen): tegels naast elkaar. Met `vormen: true` krijgt elke tegel om en om een van de drie
//   projectvormen (styles/vorm.css) en een kleurvlak; de tekstkleur is per vlak gekozen op contrast (WCAG 1.4.3).
// - beelden (Figma 537:2202): een strook kaarten met staand beeld, titel en tekst.
// - vormen (Figma 539:2357): een strook donkere vormen met titel en tekst over een groot achtergrondbeeld.
// Een strook is een carousel: swipen, slepen met de muis (met een volgcursor) of de pijlen; kaarten buiten het
// raster staan op 20% (scripts/strook.ts). `anker` maakt de sectie bereikbaar via bv. /over#diensten.
import Icon from '../Icon.astro';
import Img from '../Img.astro';
import RichText from '../RichText.astro';
import { has, type BlockProps } from './scope';

type Props = BlockProps<'services'>;
const { block } = Astro.props;
const VORMEN = ['recht', 'rond', 'schuin'] as const;
// Figma 539:2357: schuin, rond, recht.
const STROOKVORMEN = ['schuin', 'rond', 'recht'] as const;
// Vlak en tekst per tegel, om en om (kleuren uit KLEUR_SWATCH, labels.ts).
const VLAKKEN = [
  ['oklch(72% 0.18 52)', 'oklch(18% 0 0)'],
  ['oklch(52% 0.2 262)', 'oklch(99% 0 0)'],
  ['oklch(62% 0.15 150)', 'oklch(18% 0 0)'],
  ['oklch(78% 0.13 350)', 'oklch(18% 0 0)'],
  ['oklch(48% 0.2 300)', 'oklch(99% 0 0)'],
  ['oklch(88% 0.17 95)', 'oklch(18% 0 0)'],
] as const;
const strook = block.weergave !== 'raster';
const achtergrond = block.weergave === 'vormen' && block.achtergrond?.src ? block.achtergrond : undefined;
const id = has(block.anker) ? block.anker : undefined;
const vensterId = `strook-${Math.random().toString(36).slice(2, 8)}`;
---

{
  block.items.length > 0 && !strook && (
    <section class:list={['services popout', block.vormen && 'services--vormen']} id={id}>
      {has(block.kop) && <h2>{block.kop}</h2>}
      <ul role="list">
        {block.items.map((item, i) => (
          <li
            data-vorm={block.vormen ? VORMEN[i % VORMEN.length] : undefined}
            style={block.vormen ? `--tegel-vlak: ${VLAKKEN[i % VLAKKEN.length][0]}; --tegel-tekst: ${VLAKKEN[i % VLAKKEN.length][1]}` : undefined}
          >
            <h3>{item.titel}</h3>
            {has(item.tekst) && <div class="prose"><RichText value={item.tekst} /></div>}
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  block.items.length > 0 && strook && (
    <section class:list={['services services--strook feature', `services--${block.weergave}`, achtergrond && 'services--met-achtergrond']} id={id} data-strook>
      <div class="services__balk">
        {has(block.kop) && <h2 class="services__kop">{block.kop}</h2>}
        <div class="services__pijlen" data-strook-pijlen hidden>
          <button type="button" class="services__pijl" aria-controls={vensterId} aria-label="Vorige" data-strook-vorige><Icon naam="arrow-left" /></button>
          <button type="button" class="services__pijl" aria-controls={vensterId} aria-label="Volgende" data-strook-volgende><Icon naam="arrow-right" /></button>
        </div>
      </div>
      <div class="services__vlak">
        {achtergrond && (
          <Img src={achtergrond.src} alt={achtergrond.alt} sizes="100vw" class="services__achtergrond" />
        )}
        <div class="services__venster" id={vensterId} role="region" aria-label={has(block.kop) ? block.kop : 'Diensten'} tabindex="0" data-strook-venster>
          <ul role="list" class="services__rij" data-strook-rij>
            {block.items.map((item, i) => (
              <li class="services__item" data-vorm={block.weergave === 'vormen' ? STROOKVORMEN[i % STROOKVORMEN.length] : undefined}>
                {block.weergave === 'beelden' && item.beeld?.src && (
                  <Img src={item.beeld.src} alt={item.beeld.alt} sizes="(min-width: 48rem) 25vw, 75vw" class="services__beeld" />
                )}
                <div class="services__tekst">
                  <h3>{item.titel}</h3>
                  {has(item.tekst) && <RichText value={item.tekst} />}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
      {/* Volgcursor bij slepen (alleen muis); strook.ts hangt hem aan <body> en laat hem de muis volgen. */}
      <div class="services__cursor" data-strook-cursor data-richting="sleep" aria-hidden="true" hidden>
        <Icon naam="hand-move" maat={28} class="cursor-sleep" />
        <Icon naam="arrow-left" maat={28} class="cursor-links" />
        <Icon naam="arrow-right" maat={28} class="cursor-rechts" />
      </div>
    </section>
  )
}

<script>
  import '../../scripts/strook';
</script>

<style>
  .services {
    scroll-margin-block-start: var(--space-xl);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-l);
    margin-block-start: var(--space-m);
  }
  h3 {
    margin-block-end: var(--space-2xs);
  }

  /* Tegels in vormen: vierkant vlak, tekst gecentreerd; rond wordt een cirkel. */
  .services--vormen ul {
    gap: var(--space-s);
  }
  .services--vormen li {
    display: grid;
    place-content: center;
    aspect-ratio: 1;
    padding: var(--space-m);
    background: var(--tegel-vlak);
    color: var(--tegel-tekst);
    text-align: center;
    hyphens: auto;
    border-radius: var(--vorm-radius);
    clip-path: var(--vorm-clip);
  }
  /* Schuin en rond snoepen ruimte van de zijkanten: daar extra binnenruimte. */
  .services--vormen li[data-vorm='schuin'] {
    padding-inline: calc(var(--space-m) + var(--vorm-schuin));
  }
  .services--vormen li[data-vorm='rond'] {
    padding-inline: var(--space-l);
  }
  .services--vormen h3 {
    font-size: var(--step-1);
  }

  /* ── Strook (beelden en vormen) ─────────────────────────────────────────────
     Carousel: het venster scrolt horizontaal met scroll-snap en loopt rechts door tot de rand van het scherm.
     Pijlen rechts naast de kop (strook.ts); zonder JS blijven ze verborgen en werkt swipen gewoon. */
  .services--strook {
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* de rij mag de kolom niet oprekken */
    gap: var(--space-l);
  }
  .services__balk {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-m);
  }
  .services__pijlen {
    display: flex;
    gap: var(--space-2xs);
    margin-inline-start: auto;
  }
  .services__pijlen[hidden] {
    display: none;
  }
  .services__pijl {
    display: grid;
    place-items: center;
    inline-size: 2.75rem; /* raakvlak 44px */
    aspect-ratio: 1;
    padding: 0;
    border: var(--border-width) solid currentColor;
    border-radius: 100vmax;
    background: none;
    color: inherit;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, opacity 0.2s;
  }
  .services__pijl:hover:enabled {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  .services__pijl:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .services__pijl:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .services__kop {
    font-size: var(--step-4);
    font-weight: 400;
    line-height: 1.125;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .services__vlak {
    position: relative;
  }
  .services__venster {
    /* Links en rechts doorlopen tot de schermrand (vorige en volgende kaarten gedimd zichtbaar). De padding en
       scroll-padding (even breed als het stuk buiten het raster) laten de kaarten op het raster snappen. */
    --uitloop: calc(50vw - 50cqi); /* cqi = breedte van de sectie (container); % zou bij scroll-padding het venster zelf zijn */
    margin-inline: calc(-1 * var(--uitloop));
    padding-inline: var(--uitloop);
    scroll-padding-inline: var(--uitloop);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .services__venster::-webkit-scrollbar {
    display: none;
  }
  .services__venster:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }
  .services--strook .services__rij {
    --per-rij: 1.25;
    --strook-gap: var(--space-m); /* Figma Grid/Gutter = Space M */
    display: flex;
    gap: var(--strook-gap);
    margin: 0;
    inline-size: max-content;
  }
  .services__item {
    flex: 0 0 auto;
    inline-size: calc((100cqi - (var(--per-rij) - 1) * var(--strook-gap)) / var(--per-rij));
    scroll-snap-align: start;
    transition: opacity 0.3s ease-out;
  }
  /* Muis: slepen met een eigen cursor (strook.ts zet data-sleepbaar). Tijdens het slepen geen snap en
     geen tekstselectie; de snap komt terug bij loslaten. */
  .services__venster[data-sleepbaar],
  .services__venster[data-sleepbaar] .services__item[data-buiten] {
    cursor: none;
  }
  .services__venster[data-sleept] {
    scroll-snap-type: none;
    user-select: none;
  }
  .services__venster :global(img) {
    -webkit-user-drag: none;
  }
  .services__cursor {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 50;
    display: grid;
    place-items: center;
    inline-size: 5.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-fg);
    color: var(--color-bg);
    pointer-events: none;
  }
  .services__cursor[hidden] {
    display: none;
  }
  .services__cursor :global(svg) {
    grid-area: 1 / 1;
    display: none;
  }
  .services__cursor[data-richting='sleep'] :global(.cursor-sleep),
  .services__cursor[data-richting='links'] :global(.cursor-links),
  .services__cursor[data-richting='rechts'] :global(.cursor-rechts) {
    display: block;
  }
  /* Gedimde kaart (buiten het raster): klikken schuift hem erin (strook.ts). */
  .services__item[data-buiten] {
    cursor: pointer;
  }
  .services__item[data-buiten]:hover {
    opacity: 0.45 !important; /* boven de inline opacity uit strook.ts */
  }
  .services__item h3 {
    margin: 0;
    font-weight: 700;
  }
  .services__item :global(p) {
    margin: 0;
  }

  /* Beelden (537:2202): staand beeld 150:200, titel vet step--1, tekst step-0. */
  .services--beelden .services__item {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }
  /* <Img> is een eigen component: klassen erop vallen buiten de scope, dus :global. */
  .services__item :global(.services__beeld) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 150 / 200;
    object-fit: cover;
  }
  .services--beelden .services__tekst {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step-0);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .services--beelden h3 {
    font-size: var(--step--1);
    line-height: 1.2;
  }

  /* Vormen (539:2357): donkere vormen (≈ 342 × 369) met lichte tekst, gecentreerd, over een achtergrondbeeld.
     Vaste kleuren, ook in het donkere thema: ze staan op een foto. #121212 / #f2f2f2 ≈ 17:1 (WCAG 1.4.3). */
  .services--met-achtergrond .services__vlak {
    padding-block: var(--space-5xl);
  }
  .services__vlak :global(.services__achtergrond) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .services--vormen .services__item {
    display: grid;
    place-content: center;
    aspect-ratio: 342 / 369;
    padding: var(--space-l) var(--space-xl);
    background: oklch(18.2% 0 0);
    color: oklch(96% 0 0);
    text-align: center;
    hyphens: auto;
    border-radius: var(--vorm-radius);
    clip-path: var(--vorm-clip);
  }
  .services--vormen .services__item[data-vorm='recht'] {
    --vorm-radius: var(--space-l);
  }
  .services--vormen .services__item[data-vorm='schuin'] {
    padding-inline: calc(var(--space-l) + var(--vorm-schuin));
  }
  .services--vormen .services__tekst {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step-0);
    line-height: 1.2;
    text-wrap: pretty;
  }
  .services--vormen h3 {
    font-size: var(--step-1);
    line-height: 1.2;
  }

  @container (min-width: 32rem) {
    .services--strook .services__rij {
      --per-rij: 2.25;
    }
  }
  /* Desktop: drie kolommen in het raster, de rest staat erbuiten. */
  @container (min-width: 48rem) {
    .services--strook .services__rij {
      --per-rij: 3;
    }
  }
</style>
