---
import type { BlockProps } from './scope';

type Props = BlockProps<'cta'>;
const { block } = Astro.props;
---

<section class="cta">
  <p class="cta__tekst">{block.tekst}</p>
  <a class="cta__link" href={block.href}>{block.label}</a>
</section>

<style>
  /* Figma: grote vraag met een kleine link eronder. */
  .cta {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }
  .cta__tekst {
    margin: 0;
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  .cta__link {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-underline-offset: 0.2em;
  }
</style>
