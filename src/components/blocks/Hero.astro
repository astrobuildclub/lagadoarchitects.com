---
// Opening van een pagina: kop (h1) + 1–5 beelden. Eerste beeld is het LCP-beeld.
// Optioneel wisselen woorden na de kop en subkop (`kopWissel`, `subkopWissel`), zie
// src/scripts/rotating-text.ts. Screenreaders krijgen één vaste zin met alle varianten;
// zonder JS of met reduced motion staat de eerste variant er stil.
import Img from '../Img.astro';
import { resolveImage } from '../../lib/images';
import { has, type BlockProps } from './scope';

type Props = BlockProps<'hero'>;
const { block, scope } = Astro.props;
const images = block.beelden.map((b) => ({ ...b, image: resolveImage(scope, b.src, b.project) })).filter((b) => b.image);

const kopWissel = block.kopWissel.filter(has);
const subkopWissel = block.subkopWissel.filter(has);
const wisselt = kopWissel.length > 1 || subkopWissel.length > 1;

/** "a, b en c" */
const zin = (items: string[]) => (items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} en ${items.at(-1)}`);
/** Een nieuwe regel in `kop` (YAML `|-`) wordt een <br>; voor screenreaders een spatie. */
const regels = (tekst: string) => tekst.trim().split(/\s*\n\s*/);
const plat = (tekst: string) => regels(tekst).join(' ');
/** Woorden in een masker, gescheiden door gewone spaties: zo breekt de regel per woord om. */
const woorden = (phrase: string) => phrase.split(' ');
---

<section class="hero full" data-hero>
  <div class="wrapper">
    <h1 class="hero__kop" data-rotate-block>
      {
        kopWissel.length > 0 ? (
          <>
            <span class="visually-hidden">{plat(block.kop)} {zin(kopWissel)}</span>
            <span aria-hidden="true" data-rotate data-hold="2.5" data-delay="0.4">
              {regels(block.kop).map((r, i) => (
                <>
                  {i > 0 && <br />}
                  {r}
                </>
              ))}{' '}
              <span class="hero__wissel" data-words={JSON.stringify(kopWissel)}>
                {woorden(kopWissel[0]).map((w, i) => (
                  <>
                    {i > 0 && ' '}
                    <span class="w"><span class="w__i">{w}</span></span>
                  </>
                ))}
              </span>
            </span>
          </>
        ) : (
          plat(block.kop)
        )
      }
    </h1>
    {
      (has(block.subkop) || subkopWissel.length > 0) && (
        <p class="hero__subkop" data-rotate-block>
          {subkopWissel.length > 0 ? (
            <>
              <span class="visually-hidden">{block.subkop} {zin(subkopWissel)}</span>
              <span aria-hidden="true" data-rotate data-hold="3.2" data-delay="1.6">
                {block.subkop}{' '}
                <span class="hero__wissel" data-words={JSON.stringify(subkopWissel)}>
                  {woorden(subkopWissel[0]).map((w, i) => (
                    <>
                      {i > 0 && ' '}
                      <span class="w"><span class="w__i">{w}</span></span>
                    </>
                  ))}
                </span>
              </span>
            </>
          ) : (
            block.subkop
          )}
        </p>
      )
    }
    {
      (block.link || wisselt) && (
        <div class="hero__acties">
          {block.link && (
            <a class="hero__link" href={block.link.href}>
              {block.link.label} <span aria-hidden="true">→</span>
            </a>
          )}
          {wisselt && (
            <button type="button" class="hero__pauze" data-rotate-toggle aria-pressed="false" hidden>
              Animatie pauzeren
            </button>
          )}
        </div>
      )
    }
  </div>
  {
    images.length > 0 && (
      <div class="hero__beelden" data-count={images.length}>
        {images.map((b, i) => (
          <Img src={b.image!} alt={b.alt} priority={i === 0} sizes={i === 0 ? '100vw' : '50vw'} />
        ))}
      </div>
    )
  }
</section>

<script>
  import '../../scripts/rotating-text';
</script>

<style>
  .hero {
    padding-block-start: var(--space-4xl);
  }
  .hero .wrapper {
    /* Ankerpunt voor de meetkloon in rotating-text.ts */
    position: relative;
  }
  /* Geen balance/pretty uit reset.css: de regels moeten gewoon vollopen, anders
     verspringt de verdeling bij elke wissel. */
  .hero__kop,
  .hero__subkop {
    text-wrap: wrap;
  }
  .hero__kop {
    /* Mobiel kleiner, vanaf 36rem (zelfde breekpunt als ProjectList) de grote maat. */
    font-weight: 700;
    letter-spacing: -0.03em;
    font-size: min(var(--step-4), 10.5cqi);
  }
  @media (min-width: 36rem) {
    .hero__kop {
      font-size: min(var(--step-6), 10.5cqi);
    }
  }
  /* Altijd drie regels: "Wij zijn een serieus / buro voor speelse / architectuur".
     De eerste breuk staat in de content (nieuwe regel in `kop`), het laatste wisselwoord
     krijgt een eigen regel. Zo staan de twee wisselwoorden altijd op twee regels, ook bij
     "sportieve landschappen". Regel 1 en 2 zijn ±8,6em breed: de kop krimpt mee met de
     wrapper (cqi) zodat ze altijd passen. */
  .hero .wrapper {
    container-type: inline-size;
  }
  .hero__kop .hero__wissel :global(.w:last-child:not(:first-child)) {
    display: block;
    inline-size: fit-content;
  }
  .hero__subkop {
    margin-block-start: var(--space-m);
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
  }
  .hero__wissel {
    color: var(--color-accent);
  }
  .hero__subkop .hero__wissel {
    font-weight: 600;
  }

  /* Masker per woord. clip-path: inset(0) knipt op de border-box, dus de padding geeft
     ruimte aan stokken en staarten (j, p, g). De negatieve marge houdt de regelhoogte gelijk.
     Geen overflow: dat zou de basislijn van een inline-block naar de onderrand verplaatsen.
     :global omdat het script deze spans aanmaakt (zonder scope-attribuut). */
  .hero__wissel :global(.w) {
    display: inline-block;
    padding-block: 0.2em;
    margin-block: -0.2em;
    clip-path: inset(0);
  }
  .hero__wissel :global(.w__i) {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  .hero__acties {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-l);
    margin-block-start: var(--space-l);
  }
  .hero__link {
    font-weight: 700;
    text-decoration: none;
  }
  .hero__link span {
    display: inline-block;
    transition: transform var(--duration) var(--ease);
  }
  .hero__link:hover span {
    transform: translateX(0.2em);
  }
  .hero__pauze {
    padding: var(--space-3xs) 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .hero__pauze[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__link span {
      transition: none;
    }
  }

  .hero__beelden {
    display: grid;
    gap: var(--space-2xs);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-block-start: var(--space-l);
  }
  .hero__beelden :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .hero__beelden :global(img:first-child) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
</style>
