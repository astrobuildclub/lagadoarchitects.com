---
// Opening van een pagina (Figma, home): kolommen met kop (h1), subkop, optioneel adres en een korte
// tekst, klein naast elkaar; daarna 0–5 beelden. Eerste beeld is het LCP-beeld.
// Optioneel wisselen woorden na de kop en subkop (`kopWissel`, `subkopWissel`), zie
// src/scripts/rotating-text.ts. Screenreaders krijgen één vaste zin met alle varianten;
// zonder JS of met reduced motion staat de eerste variant er stil.
import Img from '../Img.astro';
import { resolveImage } from '../../lib/images';
import { getContact } from '../../lib/content';
import { md } from '../../lib/markdown';
import { has, type BlockProps } from './scope';

type Props = BlockProps<'hero'>;
const { block, scope } = Astro.props;
const images = block.beelden.map((b) => ({ ...b, image: resolveImage(scope, b.src, b.project) })).filter((b) => b.image);

const kopWissel = block.kopWissel.filter(has);
const subkopWissel = block.subkopWissel.filter(has);
const wisselt = kopWissel.length > 1 || subkopWissel.length > 1;
const contact = block.adres ? await getContact() : undefined;
const tel = contact?.telefoon?.replace(/[^\d+]/g, '').replace('(0)', '');
// Alleen kop en subkop (Figma 447:2103): twee brede kolommen in grote letters.
const groot = !contact && !has(block.tekst);

/** "a, b en c" */
const zin = (items: string[]) => (items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} en ${items.at(-1)}`);
/** Een nieuwe regel in `kop` (YAML `|-`) wordt een <br>; voor screenreaders een spatie. */
const regels = (tekst: string) => tekst.trim().split(/\s*\n\s*/);
const plat = (tekst: string) => regels(tekst).join(' ');
/** Woorden met hun spatie erachter in één span (behalve het laatste): de onderstreping loopt
 *  zo door onder de spaties en verdwijnt per woord mee. De regel breekt gewoon per woord om. */
const woorden = (phrase: string) => phrase.split(' ').map((w, i, all) => (i < all.length - 1 ? `${w} ` : w));
---

<section class:list={['hero full', groot && 'hero--groot']} data-hero>
  <div class="wrapper wrapper--full hero__kolommen">
    <div class="hero__kolom">
      <h1 class="hero__kop" data-rotate-block>
        {
          kopWissel.length > 0 ? (
            <>
              <span class="visually-hidden">{plat(block.kop)} {zin(kopWissel)}</span>
              <span aria-hidden="true" data-rotate data-hold="2" data-uit="0.125" data-leeg="0.5" data-in="0.25" data-fade="0.1" data-delay="0.2">
                {regels(block.kop).map((r, i) => (
                  <>
                    {i > 0 && <br />}
                    {r}
                  </>
                ))}{' '}
                <span class="hero__wissel" data-words={JSON.stringify(kopWissel)}>
                  {woorden(kopWissel[0]).map((w) => (
                    <span class="w"><span class="w__i">{w}</span></span>
                  ))}
                </span>
              </span>
            </>
          ) : (
            plat(block.kop)
          )
        }
      </h1>
      {
        wisselt && (
          <button type="button" class="hero__pauze" data-rotate-toggle aria-pressed="false" hidden>
            Animatie pauzeren
          </button>
        )
      }
    </div>
    {
      (has(block.subkop) || subkopWissel.length > 0) && (
        <div class="hero__kolom">
          <p class="hero__subkop" data-rotate-block>
            {subkopWissel.length > 0 ? (
              <>
                <span class="visually-hidden">{block.subkop} {zin(subkopWissel)}</span>
                <span aria-hidden="true" data-rotate data-hold="2" data-uit="0.125" data-leeg="0.5" data-in="0.25" data-fade="0.1" data-delay="0.3">
                  {block.subkop}{' '}
                  <span class="hero__wissel" data-words={JSON.stringify(subkopWissel)}>
                    {woorden(subkopWissel[0]).map((w) => (
                      <span class="w"><span class="w__i">{w}</span></span>
                    ))}
                  </span>
                </span>
              </>
            ) : (
              block.subkop
            )}
          </p>
          {block.link && (
            <a class="hero__link" href={block.link.href}>
              {block.link.label} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )
    }
    {
      contact && (
        <address class="hero__kolom hero__klein-mobiel">
          {contact.adres.naam && <>{contact.adres.naam}<br /></>}
          {contact.adres.straat}<br />
          {contact.adres.postcode} {contact.adres.plaats}
          {contact.telefoon && <><br /><a href={`tel:${tel}`}>{contact.telefoon}</a></>}
        </address>
      )
    }
    {has(block.tekst) && <div class="hero__kolom hero__tekst" set:html={md(block.tekst)} />}
  </div>
  {
    images.length > 0 && (
      <div class="wrapper wrapper--full hero__beelden" data-count={images.length}>
        {images.map((b, i) => (
          <Img src={b.image!} alt={b.alt} priority={i === 0} sizes={i === 0 ? '100vw' : '50vw'} />
        ))}
      </div>
    )
  }
</section>

<script>
  import '../../scripts/rotating-text';
</script>

<style>
  /* Kolommen klein naast elkaar: 2 op mobiel, vanaf 48rem 4 (Figma). */
  .hero {
    padding-block-start: var(--page-top);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  .hero__kolommen {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
  }
  @media (min-width: 48rem) {
    .hero__kolommen {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Ankerpunt voor de meetkloon in rotating-text.ts */
  .hero__kolom {
    position: relative;
  }
  /* Alleen kop en subkop: twee kolommen, groot (Figma: step-3, regel 1.125), het wisselwoord vet. */
  .hero--groot {
    font-size: var(--step-1);
    font-weight: 400;
  }
  .hero--groot .hero__wissel {
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    .hero--groot {
      font-size: var(--step-3);
    }
    .hero--groot .hero__kolommen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Geen balance/pretty uit reset.css: de regels moeten gewoon vollopen, anders
     verspringt de verdeling bij elke wissel. */
  .hero__kop,
  .hero__subkop {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    text-wrap: wrap;
  }
  /* Het wisselwoord staat op een eigen regel. */
  .hero__wissel {
    display: block;
  }
  /* Woord-spans (rotating-text.ts verbergt ze per woord). :global omdat het script ze aanmaakt. */
  .hero__wissel :global(:is(.w, .w__i)) {
    display: inline;
  }

  address {
    font-style: normal;
  }
  address a {
    text-decoration: none;
  }
  /* Adres en tekst op mobiel een stap kleiner, de tekst ook op desktop. */
  .hero__klein-mobiel,
  .hero__tekst {
    font-size: var(--step--2);
  }
  @media (min-width: 48rem) {
    .hero__klein-mobiel {
      font-size: inherit;
    }
  }
  .hero__tekst :global(p) {
    margin: 0;
  }

  .hero__link {
    display: inline-block;
    margin-block-start: var(--space-2xs);
    text-decoration: none;
  }
  .hero__pauze {
    margin-block-start: var(--space-2xs);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--step--2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .hero__pauze[hidden] {
    display: none;
  }

  .hero__beelden {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-block-start: var(--space-l);
  }
  .hero__beelden :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .hero__beelden :global(img:first-child) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
</style>
