---
// Pers of awards. `toonUit: bureau` haalt de items uit de list-blokken van bureau.md.
// Placeholder-items uit het sjabloon (jaar 0000, lege velden) worden niet getoond.
// `zichtbaar`: de eerste n items staan er direct, de rest zit in een <details> "Toon alles".
import ListItem from '../ListItem.astro';
import { cleanItems, getProjects, itemsFromPage } from '../../lib/content';
import { has, type BlockProps } from './scope';

type Props = BlockProps<'list'>;
const { block } = Astro.props;
const source = has(block.toonUit) ? await itemsFromPage(block.toonUit as 'bureau', block.soort) : cleanItems(block.items);
const projects = await getProjects();
const items = (block.limit ? source.slice(0, block.limit) : source).map((item) => ({
  jaar: item.jaar,
  titel: block.soort === 'pers' ? [item.medium, item.titel].filter(has).join(' — ') : item.naam,
  url: has(item.url) ? item.url : undefined,
  resultaat: block.soort === 'awards' ? item.resultaat : undefined,
  project: projects.find((p) => p.slug === item.project),
}));
const eerst = block.zichtbaar ? items.slice(0, block.zichtbaar) : items;
const rest = block.zichtbaar ? items.slice(block.zichtbaar) : [];
---

{
  items.length > 0 && (
    <section class="list">
      {has(block.kop) && <h2>{block.kop}</h2>}
      <ul role="list">
        {eerst.map((item) => <ListItem {...item} />)}
      </ul>
      {rest.length > 0 && (
        <details class="list__meer">
          <summary>Toon alles ({items.length})</summary>
          <ul role="list">
            {rest.map((item) => <ListItem {...item} />)}
          </ul>
        </details>
      )}
    </section>
  )
}

<style>
  ul {
    margin-block-start: var(--space-s);
  }
  .list__meer ul {
    margin-block-start: 0;
  }
  .list__meer summary {
    padding-block: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .list__meer summary:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .list__meer[open] summary {
    color: var(--color-muted);
  }
</style>
