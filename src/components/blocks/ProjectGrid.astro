---
import ProjectList from '../ProjectList.astro';
import { selectProjects } from '../../lib/content';
import { has, type BlockProps } from './scope';
import type { Project } from '../../lib/schema';

type Props = BlockProps<'projectGrid'>;
const { block } = Astro.props;
/**
 * Vaste indeling uit Figma (447:2103), per 8 kaarten = 4 rijen van 3: hoog, halve, hoog bovenaan
 * (de halve in het midden), dan hoog, hoog, halve en twee halve onderaan. `grid-auto-flow: dense`
 * legt ze zo neer; `homepageGrootte` uit de content geldt hier dus niet.
 */
const PATROON: Project['homepageGrootte'][] = ['hoog', 'klein', 'hoog', 'hoog', 'hoog', 'klein', 'klein', 'klein'];

const gekozen = await selectProjects(block);
// Vast aantal (`meer: false`): alleen `limit` kaarten in de vaste indeling, sluitend.
const projects = block.meer ? gekozen : sluitend(indeling(gekozen.slice(0, block.limit ?? gekozen.length)));
const stap = block.limit ?? projects.length;

function indeling(list: Project[]): Project[] {
  return list.map((p, i) => ({ ...p, homepageGrootte: PATROON[i % PATROON.length] }));
}

/**
 * Homeraster: 3 kolommen (2 op tablet), kaarten 1 of 2 rijen hoog. Het raster is dicht als het
 * aantal cellen deelbaar is door 6 (2 én 3 kolommen). Zo niet, dan worden kaarten van achteren af
 * 1 rij hoger of lager tot het dichtstbijzijnde veelvoud. `grid-auto-flow: dense` vult de gaten verder op.
 */
function sluitend(list: Project[]): Project[] {
  const hoog = (p: Project) => ['hoog', 'toren', 'groot'].includes(p.homepageGrootte);
  const uit = list.map((p) => ({ ...p }));
  let cellen = uit.reduce((n, p) => n + (hoog(p) ? 2 : 1), 0);
  // Doel: het veelvoud van 6 tussen n en 2n cellen dat het dichtst bij de huidige verdeling ligt.
  const doelen = Array.from({ length: uit.length + 1 }, (_, i) => uit.length + i).filter((c) => c % 6 === 0);
  const doel = doelen.sort((a, b) => Math.abs(a - cellen) - Math.abs(b - cellen))[0] ?? cellen;
  while (cellen !== doel) {
    const groei = cellen < doel;
    const kaart = groei ? uit.findLast((p) => !hoog(p)) : uit.findLast(hoog);
    if (!kaart) break;
    kaart.homepageGrootte = groei ? 'hoog' : 'klein';
    cellen += groei ? 1 : -1;
  }
  return uit;
}
const id = 'projecten-uitgelicht';
const links = [...(block.linkNaarOverzicht ? [block.linkNaarOverzicht] : []), ...block.links];
---

{
  projects.length > 0 && (
    <section class="project-grid full">
      {has(block.kop) && <h2>{block.kop}</h2>}
      <ProjectList projects={projects} headingLevel={has(block.kop) ? 3 : 2} id={id} sized zichtbaar={stap} />
      {projects.length > stap && (
        <p class="project-grid__acties">
          <button type="button" class="button" data-meer={id} data-stap={stap} aria-controls={id} hidden>
            Meer projecten
          </button>
        </p>
      )}
      {links.length > 0 && (
        <ul role="list" class="project-grid__links">
          {links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      )}
    </section>
  )
}

<script>
  // "Meer projecten": toont de volgende `data-stap` verborgen kaarten en zet de focus op de eerste
  // nieuwe kaart (WCAG 2.4.3), zodat toetsenbord- en schermlezergebruikers verder gaan waar het nieuwe begint.
  // Zonder JS blijft de knop verborgen; de link naar het overzicht toont dan alles.
  function initMeer() {
    document.querySelectorAll<HTMLButtonElement>('[data-meer]').forEach((knop) => {
      const lijst = document.getElementById(knop.dataset.meer!);
      if (!lijst) return;
      const stap = Number(knop.dataset.stap);
      knop.hidden = false;
      knop.addEventListener('click', () => {
        const wachtend = [...lijst.querySelectorAll<HTMLElement>('[data-later][hidden]')];
        const nu = wachtend.slice(0, stap);
        nu.forEach((kaart) => (kaart.hidden = false));
        nu[0]?.querySelector('a')?.focus();
        if (wachtend.length <= stap) knop.hidden = true;
      });
    });
  }
  document.addEventListener('astro:page-load', initMeer);

  // Stagger-reveal: zodra de eerste kaart in beeld komt, komen alle zichtbare kaarten één voor één binnen
  // (opacity en een korte verschuiving omhoog, 70 ms na elkaar, hooguit 9 stappen). De kaarten staan pas
  // op 'wacht' als JS draait, dus zonder JS of bij prefers-reduced-motion is alles meteen zichtbaar.
  function initReveal() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLElement>('.project-grid .project-list').forEach((lijst) => {
      const kaarten = [...lijst.children].filter((k): k is HTMLElement => k instanceof HTMLElement && !k.hidden);
      if (!kaarten.length) return;
      kaarten.forEach((k, i) => k.style.setProperty('--reveal-i', String(Math.min(i, 8))));
      lijst.dataset.reveal = 'wacht';
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          lijst.dataset.reveal = 'klaar';
          io.disconnect();
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      io.observe(kaarten[0]);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    });
  }
  document.addEventListener('astro:page-load', initReveal);
</script>

<style>
  /* Breakout: over de volle paginabreedte, alleen de gutter eraf (gelijk met header en footer). */
  .project-grid {
    display: grid;
    gap: var(--space-xl);
    padding-inline: var(--gutter);
  }
  /* Stagger-reveal (zie script): eerst onzichtbaar en 2rem lager, dan per kaart binnen. Met `translate`, zodat
     transforms op de kaart zelf (hover) er niet mee botsen. */
  .project-grid :global(.project-list[data-reveal] > li) {
    transition:
      opacity 0.6s var(--ease, ease) calc(var(--reveal-i, 0) * 70ms),
      translate 0.6s cubic-bezier(0.2, 0, 0, 1) calc(var(--reveal-i, 0) * 70ms);
  }
  .project-grid :global(.project-list[data-reveal='wacht'] > li) {
    opacity: 0;
    translate: 0 2rem;
  }

  /* Links onder het raster ("Alle projecten", "Over ons"): grote tekstlinks in twee helften, zoals de header
     (logo en rechterdeel elk flex 1 1 0 met gap m). De tweede link begint zo waar "Projecten" in de nav begint.
     Onder 48rem (geen nav in de balk) onder elkaar. */
  .project-grid__links {
    display: grid;
    gap: var(--space-s) var(--space-m);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  @media (min-width: 48rem) {
    .project-grid__links {
      grid-template-columns: 1fr 1fr;
    }
  }
  .project-grid__links a {
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.15em;
  }
  .project-grid__links a:hover {
    text-decoration-thickness: 0.12em;
  }
  /* "Meer projecten" (Figma 447:2103): grijze pil over de volle breedte. */
  .project-grid__acties {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
  }
  .project-grid__acties .button {
    justify-content: center;
    padding: var(--space-l) var(--space-s);
    border: 0;
    border-radius: var(--space-3xl);
    background: var(--color-surface);
    color: var(--color-fg);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  .project-grid__acties .button:hover {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  /* .button is inline-flex en zou `hidden` anders overschrijven. */
  .project-grid__acties .button[hidden] {
    display: none;
  }
</style>
