---
// Compacte footer (Figma 449:6819): boven het woordmerk met payoff, daaronder vijf kolommen:
// herkomst van de naam (twee breed), adres, bedrijfsgegevens, en privacy/cookies/credits.
import Logo from './Logo.astro';
import { downloadUrl } from '../lib/images';
import type { Contact, Settings } from '../lib/schema';

interface Props {
  settings: Settings;
  contact: Contact;
}
const { settings, contact } = Astro.props;
const { adres, bedrijf } = contact;
const links = [...settings.footer.links, ...contact.social]
  .filter((l, i, all) => l.href && all.findIndex((x) => x.href === l.href) === i);
const downloads = contact.downloads.map((d) => ({ ...d, url: downloadUrl(d.bestand) })).filter((d) => d.url);
const tel = contact.telefoon?.replace(/[^\d+]/g, '').replace('(0)', '');
---

<footer class="site-footer">
  <div class="wrapper wrapper--full site-footer__inner">
    <div class="site-footer__merk">
      <p class="site-footer__logo">
        <Logo class="site-footer__wordmark" />
        <span aria-hidden="true">architects</span>
        <span class="visually-hidden">{settings.siteNaam}</span>
      </p>
      <p>{settings.payoff}</p>
    </div>

    <div class="site-footer__grid">
      {settings.footer.tekst && <p class="site-footer__tekst">{settings.footer.tekst}</p>}

      <address>
        {adres.naam && <>{adres.naam}<br /></>}
        {adres.straat}<br />
        {adres.postcode} {adres.plaats}
        {contact.telefoon && <><br /><a href={`tel:${tel}`}>{contact.telefoon}</a></>}
        {contact.email && <><br /><a href={`mailto:${contact.email}`}>{contact.email}</a></>}
      </address>

      <ul role="list">
        {bedrijf.kvk && <li>KVK: {bedrijf.kvk}</li>}
        {bedrijf.btw && <li>BTW: {bedrijf.btw}</li>}
        {bedrijf.architectenregister && <li>Architectenregister: {bedrijf.architectenregister}</li>}
        {bedrijf.bank && <li>Bank: {bedrijf.bank}</li>}
      </ul>

      <ul role="list">
        <li><a href={settings.footer.privacy}>Privacy</a></li>
        <li>
          <button type="button" class="link-button" data-cc="show-preferencesModal">Cookie-instellingen</button>
        </li>
        {links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
        {downloads.map((d) => <li><a href={d.url} download>{d.label}</a></li>)}
        <li><a href="https://abcdinamo.com/typefaces/areal" rel="noopener">Areal by ABC Dinamo</a></li>
        <li><a href="https://allthis.digital" rel="noopener">allthis.digital</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Pagina-kleuren met een dunne lijn erboven; alles op step--1. */
  .site-footer {
    margin-block-start: var(--space-3xl);
    padding-block: var(--space-2xl);
    border-block-start: var(--border-width) solid var(--color-surface);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-m);
  }
  .site-footer__merk {
    display: grid;
    gap: 2px;
  }
  .site-footer__logo {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-weight: 400;
  }
  .site-footer :global(.site-footer__wordmark) {
    block-size: 1rem;
    inline-size: auto;
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Vijf kolommen; de tekst over twee. */
  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .site-footer__tekst {
      grid-column: span 2;
    }
  }
  .site-footer__tekst {
    max-inline-size: 60ch;
  }
  address {
    font-style: normal;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .link-button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .link-button:hover {
    text-decoration: underline;
  }
</style>
