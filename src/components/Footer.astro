---
// Compacte footer (Figma 449:6819): boven het woordmerk met payoff, daaronder vier kolommen uit de
// site-instellingen in Sanity (Footer → Kolommen). De eerste is twee keer zo breed (herkomst van de naam).
// Een link naar #cookies wordt de knop Cookie-instellingen (richtext/Link.astro).
import Logo from './Logo.astro';
import RichText from './RichText.astro';
import { heeftTekst } from '../lib/richtext';
import type { Settings } from '../lib/schema';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const kolommen = settings.footer.kolommen.filter((k) => heeftTekst(k.tekst));
---

<footer class="site-footer">
  <div class="wrapper wrapper--full site-footer__inner">
    <div class="site-footer__merk">
      <p class="site-footer__logo">
        <Logo class="site-footer__wordmark" />
        <span aria-hidden="true">architects</span>
        <span class="visually-hidden">{settings.siteNaam}</span>
      </p>
      <p>{settings.payoff}</p>
    </div>

    <div class="site-footer__grid">
      {
        kolommen.map((k, i) => (
          <div class:list={['site-footer__kolom', i === 0 && 'site-footer__tekst']}>
            <RichText value={k.tekst} />
          </div>
        ))
      }
    </div>
  </div>
</footer>

<style>
  /* Pagina-kleuren met een dunne lijn erboven; alles op step--1. */
  .site-footer {
    margin-block-start: var(--space-3xl);
    padding-block: var(--space-2xl);
    border-block-start: var(--border-width) solid var(--color-surface);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-m);
  }
  .site-footer__merk {
    display: grid;
    gap: 2px;
  }
  .site-footer__logo {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-weight: 400;
  }
  .site-footer :global(.site-footer__wordmark) {
    block-size: 1rem;
    inline-size: auto;
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Vijf kolommen; de tekst over twee. */
  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .site-footer__tekst {
      grid-column: span 2;
    }
  }
  .site-footer__tekst {
    max-inline-size: 60ch;
  }
  .site-footer__kolom :global(p + p) {
    margin-block-start: 1.125em;
  }
  .site-footer :global(a) {
    text-decoration: none;
  }
  .site-footer :global(a:hover) {
    text-decoration: underline;
  }
  .site-footer :global(.link-button) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .site-footer :global(.link-button:hover) {
    text-decoration: underline;
  }
</style>
