---
// Footer: vier kolommen uit de
// site-instellingen in Sanity (Footer → Kolommen). De eerste is twee keer zo breed (herkomst van de naam).
// Onderaan het kinetische woordmerk over de volle breedte (zwart-wit).
// Een link naar #cookies wordt de knop Cookie-instellingen (richtext/Link.astro).
import Wordmark from './brand/Wordmark.astro';
import { maakVersie } from '../lib/brand/wordmark';
import RichText from './RichText.astro';
import { heeftTekst } from '../lib/richtext';
import type { Settings } from '../lib/schema';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const kolommen = settings.footer.kolommen.filter((k) => heeftTekst(k.tekst));
---

<footer class="site-footer">
  <div class="wrapper wrapper--full site-footer__inner">
    <div class="site-footer__grid">
      {
        kolommen.map((k, i) => (
          <div class:list={['site-footer__kolom', i === 0 && 'site-footer__tekst']}>
            <RichText value={k.tekst} />
          </div>
        ))
      }
    </div>

    <Wordmark mono versie={maakVersie(settings.woordmerk.footer)} class="site-footer__wordmark" label={settings.siteNaam} />
  </div>
</footer>

<script>
  // Brand story inkleuren: bij elke pagina een willekeurige projectkleur (lijst uit Intro.astro), en zodra de
  // tekst voor de helft in beeld is groeit het vlak omhoog (CSS). Eén keer per pagina.
  function initInkleuren() {
    const tekst = document.querySelector<HTMLElement>('.site-footer__tekst');
    const kleuren = (window as { lagadoKleuren?: { vlak: string; tekst: string }[] }).lagadoKleuren ?? [];
    if (!tekst || kleuren.length === 0) return;
    const kleur = kleuren[Math.floor(Math.random() * kleuren.length)];
    tekst.style.setProperty('--footer-vlak', kleur.vlak);
    tekst.style.setProperty('--footer-tekst', kleur.tekst);
    tekst.dataset.inkleuren = 'uit';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        tekst.dataset.inkleuren = 'aan';
      },
      { threshold: 0.5 },
    );
    io.observe(tekst);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', initInkleuren);
</script>

<style>
  /* Pagina-kleuren met een dunne lijn erboven; alles op step--1. */
  .site-footer {
    margin-block-start: var(--space-3xl);
    padding-block: var(--space-2xl);
    border-block-start: var(--border-width) solid var(--color-surface);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  .site-footer__inner {
    display: grid;
    gap: var(--space-2xl);
  }
  .site-footer :global(.site-footer__wordmark) {
    inline-size: 100%;
  }
  .site-footer__grid {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Vijf kolommen; de tekst over twee. */
  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .site-footer__tekst {
      grid-column: span 2;
    }
  }
  .site-footer__tekst {
    max-inline-size: 60ch;
  }
  /* Het verhaal achter de naam kleurt in zodra het in beeld komt: een vlak in een projectkleur, zoals de intro,
     dat van onderen omhoog groeit (script hieronder). De padding staat er altijd, zodat er niets verspringt.
     Zonder JS of zonder kleuren: gewoon tekst. Bij `prefers-reduced-motion` meteen ingekleurd, zonder animatie. */
  .site-footer__tekst[data-inkleuren] {
    position: relative;
    isolation: isolate;
    align-self: start;
    padding: var(--space-s);
    transition: color 0.6s var(--ease) 0.3s;
  }
  .site-footer__tekst[data-inkleuren]::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--footer-vlak);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .site-footer__tekst[data-inkleuren='aan'] {
    color: var(--footer-tekst);
  }
  .site-footer__tekst[data-inkleuren='aan']::before {
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-footer__tekst[data-inkleuren],
    .site-footer__tekst[data-inkleuren]::before {
      transition: none;
    }
  }
  .site-footer__kolom :global(p + p) {
    margin-block-start: 1.125em;
  }
  .site-footer :global(a) {
    text-decoration: none;
  }
  .site-footer :global(a:hover) {
    text-decoration: underline;
  }
  .site-footer :global(.link-button) {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .site-footer :global(.link-button:hover) {
    text-decoration: underline;
  }
</style>
