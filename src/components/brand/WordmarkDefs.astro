---
// Defs van het kinetische woordmerk: één keer per pagina renderen. Elke stand is een los pad (#wm-L1 …),
// elke letter een geanimeerde glyph (#wm-gL …) met SMIL: geen JavaScript nodig voor de animatie. De frames
// zijn vooraf uitgerekend (raster.ts, animatie()), daarom calcMode linear en geen keySplines.
// Kleur via --g op de <use> of een ouder; die erft door in de schaduwboom van de <use>.
// Kleine variant: eigen standen en een glyph per letter (#wm-k-gL …) die één keer speelt (begin="indefinite"),
// gestart door het script hieronder bij laden en bij hover of focus. Zonder JavaScript staat hij stil.
import { LETTERS, SCHETSEN } from '../../lib/brand/wordmark';

const grootIds = new Set(LETTERS.flatMap((l) => l.standen.map((s) => s.id)));
const kleinStanden = LETTERS.flatMap((l) => l.klein.standen).filter((s) => !grootIds.has(s.id));

---

<svg class="wm-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    {
      LETTERS.flatMap((l) =>
        l.standen.map((s) => <path id={`wm-${s.id}`} class="wm-gp" d={s.d} fill-rule="evenodd" />),
      )
    }
    {SCHETSEN.filter((s) => s !== null).map((s) => <path id={`wm-${s.id}`} class="wm-gp" d={s.d} fill-rule="evenodd" />)}
    {
      LETTERS.map((l) => (
        <g id={`wm-${l.id}`}>
          <path class="wm-gp" d={l.standen[l.stappen[0].stand].d} fill-rule="evenodd">
            <animate
              attributeName="d"
              dur={`${l.duur}s`}
              begin={`${l.begin}s`}
              repeatCount="indefinite"
              calcMode="linear"
              keyTimes={l.anim.keyTimes}
              values={l.anim.values}
            />
          </path>
        </g>
      ))
    }
    {kleinStanden.map((s) => <path id={`wm-${s.id}`} class="wm-gp" d={s.d} fill-rule="evenodd" />)}
    {
      LETTERS.map((l) => (
        <g id={`wm-k-${l.id}`}>
          <path class="wm-gp" d={l.klein.standen[l.klein.stappen[0].stand].d} fill-rule="evenodd">
            {l.klein.anim && (
              <animate
                class="wm-k-anim"
                attributeName="d"
                dur={`${l.klein.duur}s`}
                begin="indefinite"
                calcMode="linear"
                keyTimes={l.klein.anim.keyTimes}
                values={l.klein.anim.values}
              />
            )}
          </path>
        </g>
      ))
    }
  </defs>
</svg>

<script>
  // Kleine variant één keer afspelen: bij laden en bij hover of focus op het woordmerk (of de link eromheen).
  // Niet bij reduced motion of pauze; dan toont de CSS de stilstaande versie.
  const stil = () => matchMedia('(prefers-reduced-motion: reduce)').matches || 'wmPauze' in document.documentElement.dataset;
  let klaar = 0;

  function speel() {
    const anims = [...document.querySelectorAll<SVGAnimationElement>('.wm-defs .wm-k-anim')];
    if (!anims.length || stil() || performance.now() < klaar) return;
    anims.forEach((a) => a.beginElement());
    klaar = performance.now() + Math.max(...anims.map((a) => a.getSimpleDuration())) * 1000;
  }

  function koppel() {
    klaar = 0;
    document.querySelectorAll<SVGElement>('.wm--klein').forEach((wm) => {
      const doel = wm.closest('a') ?? wm;
      if ((doel as HTMLElement).dataset.wmKlein) return;
      (doel as HTMLElement).dataset.wmKlein = '';
      doel.addEventListener('pointerenter', speel);
      doel.addEventListener('focusin', speel);
    });
    speel();
  }

  document.addEventListener('astro:page-load', koppel);
  if (!document.querySelector('meta[name="astro-view-transitions-enabled"]')) koppel();
</script>

<style is:global>
  .wm-defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }
  .wm-gp {
    fill: var(--g, currentColor);
  }

  /* Stilstaande versie: bij reduced motion en als de animatie op pauze staat (WCAG 2.2.2). */
  .wm-still {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .wm-anim {
      display: none;
    }
    .wm-still {
      display: inline;
    }
  }
  :root[data-wm-pauze] .wm-anim {
    display: none;
  }
  :root[data-wm-pauze] .wm-still {
    display: inline;
  }

  /* Kleur. Zwart-wit volgt het thema; [data-kleur] op de wortel zet het palet aan. */
  :root {
    --wm-geel: oklch(88.58% 0.158 95.71);
    --wm-rood: oklch(63.37% 0.2004 34.06);
    --wm-groen: oklch(68.61% 0.1164 159.26);
    --wm-roze: oklch(80.21% 0.1106 340.69);
    --wm-blauw: oklch(51.51% 0.2539 272.56);
    --wm-zwart: oklch(0% 0 0);
    --wm-wit: oklch(100% 0 0);
  }
</style>
