---
import type { Settings } from '../lib/schema';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { cleanPath } from '../lib/url';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const path = cleanPath(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrapper site-header__inner">
    <a class="site-header__logo" href="/">
      <Logo class="site-header__wordmark" />
      <span class="visually-hidden">{settings.siteNaam}</span>
    </a>
    <nav aria-label="Hoofdmenu">
      <ul role="list">
        {
          settings.navigatie.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : isCurrent(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--space-s);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
  }
  .site-header__logo {
    display: inline-flex;
    margin-inline-end: auto;
    /* Het woordmerk is fill="currentColor": kleur hier sturen.
       --color-accent, niet --accent: projectpagina's overschrijven die laatste. */
    color: var(--color-accent);
  }
  .site-header__logo :global(.site-header__wordmark) {
    /* Hoogte bepaalt de maat; breedte volgt de viewBox (65 × 14). */
    block-size: calc(var(--step-0) * 0.9);
    inline-size: auto;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  nav a {
    text-decoration: none;
  }
  nav a[aria-current] {
    text-decoration: underline;
  }
</style>
