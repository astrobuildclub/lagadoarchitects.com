---
import type { Settings } from '../lib/schema';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { cleanPath } from '../lib/url';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const path = cleanPath(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrapper wrapper--full site-header__inner">
    <a class="site-header__logo" href="/">
      <Logo class="site-header__wordmark" />
      <span class="visually-hidden">{settings.siteNaam}</span>
    </a>
    <button type="button" class="site-header__menu" aria-expanded="false" aria-controls="hoofdmenu" data-menu-toggle hidden>
      menu
    </button>
    <nav aria-label="Hoofdmenu" id="hoofdmenu">
      <ul role="list">
        {
          settings.navigatie.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : isCurrent(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<script>
  // Mobiel: het menu klapt uit onder de balk (Figma: "menu"). Zonder JS staan de links er gewoon.
  function initMenu() {
    const knop = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!knop) return;
    const header = knop.closest<HTMLElement>('.site-header')!;
    header.dataset.menu = 'dicht';
    knop.hidden = false;
    knop.addEventListener('click', () => {
      const open = knop.getAttribute('aria-expanded') !== 'true';
      knop.setAttribute('aria-expanded', String(open));
      header.dataset.menu = open ? 'open' : 'dicht';
    });
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && knop.getAttribute('aria-expanded') === 'true') {
        knop.click();
        knop.focus();
      }
    });
  }
  document.addEventListener('astro:page-load', initMenu);
</script>

<style>
  /* Balk in inkt (Figma): logo links, menu rechts. Omgekeerd t.o.v. de pagina: donker bij licht thema, licht bij donker. */
  .site-header {
    --color-focus: var(--color-on-ink);
    --font-darkmode: var(--ink-darkmode);
    font-variation-settings: 'DRKM' var(--font-darkmode);
    display: flex;
    align-items: center;
    min-block-size: 3.5rem;
    padding-block: var(--space-s);
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
  }
  .site-header__logo {
    display: inline-flex;
    margin-inline-end: auto;
  }
  .site-header__logo :global(.site-header__wordmark) {
    /* Hoogte bepaalt de maat; breedte volgt de viewBox (140 × 28). */
    block-size: 1.25rem;
    inline-size: auto;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  nav a {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.125;
    text-decoration: none;
  }
  .site-header__menu {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.125;
    cursor: pointer;
  }
  .site-header__menu[hidden] {
    display: none;
  }
  /* Mobiel met JS: links pas zichtbaar na "menu", onder de balk over de volle breedte. */
  @media (max-width: 47.99rem) {
    .site-header[data-menu] nav {
      order: 1;
      flex-basis: 100%;
    }
    .site-header[data-menu='dicht'] nav {
      display: none;
    }
    .site-header[data-menu] ul {
      flex-direction: column;
      gap: var(--space-2xs);
      padding-block: var(--space-s) var(--space-2xs);
    }
  }
  @media (min-width: 48rem) {
    .site-header__menu {
      display: none;
    }
  }
  nav a:hover,
  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 0.07em;
    text-underline-offset: 0.15em;
  }
</style>
