---
import type { Settings } from '../lib/schema';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { cleanPath } from '../lib/url';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const path = cleanPath(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrapper wrapper--full site-header__inner">
    <a class="site-header__logo" href="/">
      <Logo class="site-header__wordmark" />
      <span class="site-header__toevoeging" aria-hidden="true">architects</span>
      <span class="visually-hidden">{settings.siteNaam}</span>
    </a>
    <button type="button" class="site-header__menu" aria-expanded="false" aria-controls="hoofdmenu" data-menu-toggle hidden>
      menu
    </button>
    <nav aria-label="Hoofdmenu" id="hoofdmenu">
      <ul role="list">
        {
          settings.navigatie.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : isCurrent(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-header__thema"><ThemeToggle /></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobiel: het menu klapt uit onder de balk (Figma: "menu"). Zonder JS staan de links er gewoon.
  function initMenu() {
    const knop = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!knop) return;
    const header = knop.closest<HTMLElement>('.site-header')!;
    header.dataset.menu = 'dicht';
    knop.hidden = false;
    knop.addEventListener('click', () => {
      const open = knop.getAttribute('aria-expanded') !== 'true';
      knop.setAttribute('aria-expanded', String(open));
      header.dataset.menu = open ? 'open' : 'dicht';
    });
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && knop.getAttribute('aria-expanded') === 'true') {
        knop.click();
        knop.focus();
      }
    });
  }
  document.addEventListener('astro:page-load', initMenu);
</script>

<style>
  /* Balk (Figma 447:2104): logo links, rechts de helft van de breedte met even brede pill-knoppen
     (menu en thema), grijs vlak; de huidige pagina en hover in de tekstkleur, omgekeerd. */
  .site-header {
    padding-block: var(--space-m);
    background: var(--color-bg);
    color: var(--color-fg);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
  }
  .site-header__logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-inline-end: auto;
    text-decoration: none;
  }
  .site-header__logo :global(.site-header__wordmark) {
    /* Hoogte bepaalt de maat; breedte volgt de viewBox (140 × 28). */
    block-size: 1rem;
    inline-size: auto;
  }
  .site-header__toevoeging {
    font-size: var(--step--1);
    letter-spacing: -0.02em;
    line-height: 1.125;
  }
  ul {
    display: flex;
  }
  li {
    flex: 1 1 0;
  }
  /* Themaknop: alleen het icoon, niet mee-rekken. */
  li.site-header__thema {
    flex: 0 0 auto;
  }
  nav a,
  li :global(.theme-toggle),
  .site-header__menu {
    display: flex;
    justify-content: center;
    align-items: center;
    inline-size: 100%;
    block-size: auto;
    min-block-size: 2.75rem;
    padding: var(--space-xs) var(--space-m);
    border: 0;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-fg);
    font-family: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.125;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }
  nav a:hover,
  nav a[aria-current],
  li :global(.theme-toggle:hover),
  .site-header__menu:hover,
  .site-header__menu[aria-expanded='true'] {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  .site-header__menu {
    inline-size: auto;
  }
  .site-header__menu[hidden] {
    display: none;
  }
  /* Mobiel met JS: pills pas zichtbaar na "menu", onder de balk over de volle breedte, onder elkaar. */
  @media (max-width: 47.99rem) {
    .site-header[data-menu] nav {
      order: 1;
      flex-basis: 100%;
    }
    .site-header[data-menu='dicht'] nav {
      display: none;
    }
    .site-header[data-menu] ul {
      flex-direction: column;
      gap: var(--space-3xs);
      padding-block: var(--space-xs) 0;
    }
  }
  @media (min-width: 48rem) {
    .site-header__menu {
      display: none;
    }
    nav {
      flex: 0 1 50%;
    }
  }
</style>
